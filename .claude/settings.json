{
  "env": {
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/worktree-create\"",
            "timeout": 300
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/worktree-remove\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(sed -n:*)",
      "Bash(shasum:*)",
      "Bash(xxd:*)",
      "Bash(base64:*)",
      "Bash(source .worktree-db)",
      "Bash(source .env)",
      "Bash(source .env.local)",
      "Bash(source .env.development)",
      "Bash(source .env.development.local)"
    ]
  },
  "enabledPlugins": {}
}
