# .claudeignore — exclude large/generated tracked files from Claude context
# Note: node_modules, build, dist, etc. must be explicitly listed here because
# Claude Code's search tools may bypass .gitignore when scanning for dotfiles

# Heavy directories (gitignored but must be listed explicitly)
node_modules/
build/
dist/
.dart_tool/
.gradle/
Pods/
.worktrees/
.git/
python_modules/
.claude/worktrees/
.nx/

# Lock files (pnpm-lock.yaml is ~17k lines)
pnpm-lock.yaml

# Generated Dart files (tracked but auto-generated)
*.g.dart

# Database migrations (146 files, read on-demand when needed)
libs/db/migrations/

# Subpackage env files (generated by pnpm get-env — root .env* are kept as templates)
apps/**/.env*
workers/**/.env*
libs/**/.env*
twists/**/.env*
public/**/.env*
apps/**/.dev.vars*
workers/**/.dev.vars*
