# .claudeignore — exclude large/generated tracked files from Claude context
# Note: .gitignore entries (node_modules, build, dist, etc.) are already excluded

# Lock files (pnpm-lock.yaml is ~17k lines)
pnpm-lock.yaml

# Generated Dart files (tracked but auto-generated)
*.g.dart

# Database migrations (146 files, read on-demand when needed)
libs/db/migrations/

# Subpackage env files (generated by pnpm get-env — root .env* are kept as templates)
apps/**/.env*
workers/**/.env*
libs/**/.env*
twists/**/.env*
public/**/.env*
apps/**/.dev.vars*
workers/**/.dev.vars*
