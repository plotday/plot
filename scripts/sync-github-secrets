#!/usr/bin/env bash

# Syncs 1Password secrets to GitHub Actions secrets.
#
# App config secrets are derived automatically from op:// references in root
# .env and .env.production — to add a new app variable, add it there.
#
# CI-only secrets (deploy credentials, signing assets) are listed explicitly
# in the "CI-only secrets" section below.
#
# Requires: op (1Password CLI, authenticated), gh (GitHub CLI, authenticated),
#           node (for package.json parsing), jq (for JSON building).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

set_secret() {
  local name="$1"
  local value="$2"
  if [ -z "$value" ]; then
    echo "  ✗ $name: refusing to set empty value (check 1Password reference)" >&2
    exit 1
  fi
  printf '%s' "$value" | gh secret set "$name"
  echo "  ✓ $name (len=${#value})"
}

set_file_secret() {
  local name="$1"
  local ref="$2"
  local tmp
  tmp=$(mktemp)
  op read --force --out-file "$tmp" "$ref"
  if [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    echo "  ✗ $name: refusing to set empty value (check 1Password reference: $ref)" >&2
    exit 1
  fi
  # `op read --out-file` writes raw bytes for file attachments and plain
  # text for STRING fields. A STRING field that already holds base64 must
  # be passed through unchanged — re-encoding it produces double-base64
  # that CI decodes back to ASCII, not to the underlying file. Detect by
  # character set: if every byte belongs to the base64 alphabet (plus
  # whitespace), treat the file as pre-encoded.
  local raw_size
  raw_size=$(wc -c <"$tmp" | tr -d ' ')
  if LC_ALL=C grep -qE '[^A-Za-z0-9+/=[:space:]]' "$tmp"; then
    base64 <"$tmp" | gh secret set "$name"
    local kind="binary raw=$raw_size"
  else
    gh secret set "$name" <"$tmp"
    local kind="base64 passthrough len=$raw_size"
  fi
  rm -f "$tmp"
  echo "  ✓ $name ($kind)"
}

# ---------------------------------------------------------------------------
# App config secrets: read from .env and .env.production templates.
# .env.production overrides .env when both define the same key.
# ---------------------------------------------------------------------------

echo "=== Syncing app config secrets from .env templates ==="

declare -A OP_REFS
declare -A PLAIN_VALS

for file in "$REPO_ROOT/.env" "$REPO_ROOT/.env.production"; do
  [ -f "$file" ] || continue
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
    \#* | '') continue ;;
    *=op://*)
      name="${line%%=*}"
      ref="${line#*=}"
      ref="${ref//\$ENV/Production}" # resolve $ENV placeholder
      OP_REFS["$name"]="$ref"
      unset "PLAIN_VALS[$name]" 2>/dev/null || true
      ;;
    *=*)
      name="${line%%=*}"
      value="${line#*=}"
      PLAIN_VALS["$name"]="$value"
      unset "OP_REFS[$name]" 2>/dev/null || true
      ;;
    esac
  done <"$file"
done

for name in "${!OP_REFS[@]}"; do
  value=$(op read "${OP_REFS[$name]}")
  set_secret "$name" "$value"
done

# Plain values from templates are not synced — they're committed to the repo
# and don't need to be in GitHub secrets.

# ---------------------------------------------------------------------------
# CI-only secrets: deploy credentials and signing assets.
# These don't belong in app env templates; add new ones here directly.
# ---------------------------------------------------------------------------

echo "=== Syncing CI-only secrets ==="

# Cloudflare (deploy auth — not app config)
set_secret CF_API_TOKEN "$(op read 'op://Production/Cloudflare/credential')"
set_secret CF_ACCOUNT_ID "$(op read 'op://Production/Cloudflare/username')"
set_secret CF_R2_ACCESS_KEY_ID "$(op read 'op://Production/cloudflare/build uploads/r2 access key id')"
set_secret CF_R2_SECRET_ACCESS_KEY "$(op read 'op://Production/cloudflare/build uploads/r2 secret access key')"
set_secret CF_R2_BUCKET_NAME "$(op read 'op://Production/cloudflare/build uploads/r2 bucket name')"

# Database migration (CI runner credentials)
set_secret GCP_SA_KEY "$(op read 'op://Production/Database/service account/plot-ci-migrator-key.json')"
set_secret MIGRATOR_PASSWORD "$(op read 'op://Production/Database/migrator/password')"

# Shorebird OTA
set_secret SHOREBIRD_TOKEN "$(op read 'op://Production/Shorebird/credential')"

# Twist deploy CLI (Plot publisher token, minted by the
# 20260416152401_remove_twist_admin migration; retrieve via
# SELECT token FROM token WHERE name = 'Plot Publisher (CI)' AND archived_at IS NULL;)
set_secret PLOT_DEPLOY_TOKEN "$(op read 'op://Production/Plot Publisher CI/credential')"

# Apple code signing
# NOTE: `distribution p12` and `installer p12` are STRING fields that already
# contain the base64-encoded p12. Pass them through unchanged — running them
# through set_file_secret would re-encode and break decoding in CI.
set_secret APPLE_DIST_CERT_BASE64 "$(op read 'op://Production/Apple/Signing/distribution p12')"
set_secret APPLE_DIST_CERT_PASSWORD "$(op read 'op://Production/Apple/Signing/distribution password')"
set_secret APPLE_INSTALLER_CERT_BASE64 "$(op read 'op://Production/Apple/Signing/installer p12')"
set_secret APPLE_INSTALLER_CERT_PASSWORD "$(op read 'op://Production/Apple/Signing/installer password')"
set_file_secret ASC_API_KEY_P8_BASE64 "op://Production/Apple/App Store Connect/key.p8"
set_secret ASC_API_KEY_ID "$(op read 'op://Production/Apple/App Store Connect/key id')"
set_secret ASC_API_ISSUER_ID "$(op read 'op://Production/Apple/App Store Connect/issuer id')"
set_file_secret IOS_MOBILEPROVISION_BASE64 "op://Production/Apple/Signing/ios.mobileprovision"
set_file_secret IOS_SHARE_EXT_MOBILEPROVISION_BASE64 "op://Production/Apple/Signing/ios-share-extension.mobileprovision"
set_file_secret MACOS_PROVISIONPROFILE_BASE64 "op://Production/Apple/Signing/macos.provisionprofile"

# Android signing
set_file_secret ANDROID_KEYSTORE_BASE64 "op://Production/Android Signing/plot-release.jks"
set_secret ANDROID_KEYSTORE_PASSWORD "$(op read 'op://Production/Android Signing/keystore_password')"
set_secret ANDROID_KEY_PASSWORD "$(op read 'op://Production/Android Signing/key_password')"
set_file_secret PLAY_STORE_SERVICE_KEY "op://Production/Android Signing/Play Store/play-deployer-service-key.json"

# Firebase
set_file_secret FIREBASE_ANDROID_GOOGLE_SERVICES "op://Production/Firebase Cloud Messaging/android/google-services.json"
set_file_secret FIREBASE_IOS_GOOGLE_SERVICE_INFO "op://Production/Firebase Cloud Messaging/apple/GoogleService-Info.plist"

# Windows signing
set_file_secret WINDOWS_CODESIGN_PFX_BASE64 "op://Production/Windows Signing/plot-codesign.pfx"
set_secret WINDOWS_CODESIGN_PASSWORD "$(op read 'op://Production/Windows Signing/password')"

# ---------------------------------------------------------------------------
# Flutter app .env (pre-rendered so CI doesn't need 1Password or gen-env)
# ---------------------------------------------------------------------------

echo "=== Generating FLUTTER_ENV_PROD ==="

FLUTTER_DEPLOY_VARS=$(node -e \
  "const p=require('$REPO_ROOT/apps/plot/package.json'); \
   process.stdout.write(p.config?.deploy_vars||'')")

if [ -n "$FLUTTER_DEPLOY_VARS" ]; then
  FLUTTER_ENV=$(cd "$REPO_ROOT/apps/plot" && bash ../../scripts/gen-env production $FLUTTER_DEPLOY_VARS)
  set_secret FLUTTER_ENV_PROD "$FLUTTER_ENV"
fi

# ---------------------------------------------------------------------------
# Cloudflare Worker secret bundles (keyed by worker name).
# Stored as a single WORKER_CONFIGS_JSON so matrix jobs can look up by name.
# ---------------------------------------------------------------------------

echo "=== Generating WORKER_CONFIGS_JSON ==="

CONFIGS="{}"

for worker_dir in "$REPO_ROOT"/workers/*/; do
  worker=$(basename "$worker_dir")
  pkg="$worker_dir/package.json"
  [ -f "$pkg" ] || continue

  DEPLOY_VARS=$(node -e \
    "const p=require('$pkg'); process.stdout.write(p.config?.deploy_vars||'')")
  [ -n "$DEPLOY_VARS" ] || continue

  echo "  Building bundle for $worker..."
  ALL=$(cd "$worker_dir" && bash ../../scripts/gen-env production $DEPLOY_VARS)

  SECRETS_PART=$(printf '%s' "$ALL" | grep -E 'SECRET|KEY|TOKEN' || true)
  SECRETS_JSON=$(printf '%s' "$SECRETS_PART" | bash "$REPO_ROOT/scripts/env-to-json")

  VARS_PART=$(printf '%s' "$ALL" | grep -Ev 'SECRET|KEY|TOKEN' || true)
  VARS_FORMATTED=$(printf '%s' "$VARS_PART" | sed 's/=/:/g' | tr '\n' ' ' | sed 's/ $//')

  CONFIGS=$(printf '%s' "$CONFIGS" | jq \
    --arg w "$worker" \
    --argjson s "$SECRETS_JSON" \
    --arg v "$VARS_FORMATTED" \
    '. + {($w): {"secrets": $s, "vars": $v}}')
done

set_secret WORKER_CONFIGS_JSON "$CONFIGS"

# ---------------------------------------------------------------------------
# Site secret bundle (apps/site deploy vars for Cloudflare Pages)
# ---------------------------------------------------------------------------

echo "=== Generating site secret bundle ==="

SITE_PKG="$REPO_ROOT/apps/site/package.json"
if [ -f "$SITE_PKG" ]; then
  SITE_DEPLOY_VARS=$(node -e \
    "const p=require('$SITE_PKG'); process.stdout.write(p.config?.deploy_vars||'')")

  if [ -n "$SITE_DEPLOY_VARS" ]; then
    ALL=$(cd "$REPO_ROOT/apps/site" && bash ../../scripts/gen-env production $SITE_DEPLOY_VARS)

    SECRETS_PART=$(printf '%s' "$ALL" | grep -E 'SECRET|KEY|TOKEN' || true)
    SECRETS_JSON=$(printf '%s' "$SECRETS_PART" | bash "$REPO_ROOT/scripts/env-to-json")

    VARS_PART=$(printf '%s' "$ALL" | grep -Ev 'SECRET|KEY|TOKEN' || true)
    VARS_FORMATTED=$(printf '%s' "$VARS_PART" | sed 's/=/:/g' | tr '\n' ' ' | sed 's/ $//')

    set_secret SITE_SECRETS_JSON "$SECRETS_JSON"
    set_secret SITE_VARS "$VARS_FORMATTED"
  fi
fi

echo "=== Done ==="
