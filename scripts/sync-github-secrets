#!/usr/bin/env bash

# Syncs 1Password secrets to GitHub Actions secrets.
#
# App config secrets are derived automatically from op:// references in root
# .env and .env.production — to add a new app variable, add it there.
#
# CI-only secrets (deploy credentials, signing assets) are listed explicitly
# in the "CI-only secrets" section below.
#
# Requires: op (1Password CLI, authenticated), gh (GitHub CLI, authenticated),
#           node (for package.json parsing), jq (for JSON building).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# ---------------------------------------------------------------------------
# Modes:
#   (default)     resolve every secret and PUSH it to GitHub Actions.
#   --hash-only   resolve everything and print a content hash of exactly what
#                 *would* be pushed, WITHOUT touching GitHub. Secrets change
#                 rarely, so CI uses this hash as an Actions cache key to skip
#                 the (slow) push entirely when nothing has changed.
#
# The hash is taken over what flows through gh_secret_set — the single funnel
# every push (app config, CI-only, file attachments, worker/site bundles) goes
# through — so it can't miss a secret or drift from the push logic.
# ---------------------------------------------------------------------------
MODE="push"
case "${1:-}" in
--hash-only) MODE="hash" ;;
"") ;;
*)
  echo "Usage: $0 [--hash-only]" >&2
  exit 2
  ;;
esac

# gen-env, with ENV=production, also fetches Android/Apple/Firebase/Windows
# signing assets to local paths and regenerates key.properties. The secret
# sync only consumes gen-env's stdout (env text) for the bundles — never those
# local files — so skip that work. Saves time on every run and keeps the run
# from churning local files; app-build callers leave the flag unset.
export GEN_ENV_SKIP_LOCAL_FILES=1

HASH_BUF=
if [ "$MODE" = hash ]; then
  HASH_BUF=$(mktemp)
  # Keep stdout reserved for the final hash; send all progress to stderr.
  exec 3>&1 1>&2
fi

# Set a GitHub Actions secret named "$1" to the contents of file "$2",
# retrying transient API failures with exponential backoff.
#
# GitHub's `PUT /actions/secrets/{name}` endpoint intermittently returns
# HTTP 5xx (server-side flake). The PUT is idempotent, so retrying is safe.
# Without this a single transient 500 trips `set -e` and aborts the whole
# refresh, leaving every secret after the failing one stale and emitting a
# confusing red annotation — e.g. `failed to set secret "AUTH_MICROSOFT_ID":
# HTTP 500`. Permanent errors (4xx — bad value, missing repo, secret limit)
# are not retried so genuine misconfiguration still fails fast.
gh_secret_set() {
  local name="$1"
  local file="$2"
  if [ "$MODE" = hash ]; then
    # Hash mode: record name + content digest instead of pushing. Sorted at
    # the end so push order / assoc-array iteration can't change the hash.
    printf '%s\t%s\n' "$name" "$(sha256sum <"$file" | cut -d' ' -f1)" >>"$HASH_BUF"
    return 0
  fi
  local attempt=1
  local max=5
  local delay=2
  local err
  while true; do
    if err=$(gh secret set "$name" <"$file" 2>&1); then
      return 0
    fi
    if [ "$attempt" -ge "$max" ] ||
      ! printf '%s' "$err" | grep -qiE 'HTTP 5[0-9][0-9]|timeout|timed out|connection (reset|refused|closed)|EOF|temporarily|try again'; then
      printf '%s\n' "$err" >&2
      return 1
    fi
    printf '  … %s: transient error (attempt %d/%d), retrying in %ds\n' \
      "$name" "$attempt" "$max" "$delay" >&2
    sleep "$delay"
    attempt=$((attempt + 1))
    delay=$((delay * 2))
  done
}

set_secret() {
  local name="$1"
  local value="$2"
  if [ -z "$value" ]; then
    echo "  ✗ $name: refusing to set empty value (check 1Password reference)" >&2
    exit 1
  fi
  local tmp
  tmp=$(mktemp)
  printf '%s' "$value" >"$tmp"
  if ! gh_secret_set "$name" "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
  echo "  ✓ $name"
}

set_file_secret() {
  local name="$1"
  local ref="$2"
  local tmp
  tmp=$(mktemp)
  op read --force --out-file "$tmp" "$ref"
  if [ ! -s "$tmp" ]; then
    rm -f "$tmp"
    echo "  ✗ $name: refusing to set empty value (check 1Password reference: $ref)" >&2
    exit 1
  fi
  # `op read --out-file` writes raw bytes for file attachments and plain
  # text for STRING fields. A STRING field that already holds base64 must
  # be passed through unchanged — re-encoding it produces double-base64
  # that CI decodes back to ASCII, not to the underlying file. Detect by
  # character set: if every byte belongs to the base64 alphabet (plus
  # whitespace), treat the file as pre-encoded.
  local kind payload
  payload=$(mktemp)
  if LC_ALL=C grep -qE '[^A-Za-z0-9+/=[:space:]]' "$tmp"; then
    base64 <"$tmp" >"$payload"
    kind="binary"
  else
    cp "$tmp" "$payload"
    kind="base64 passthrough"
  fi
  rm -f "$tmp"
  if ! gh_secret_set "$name" "$payload"; then
    rm -f "$payload"
    return 1
  fi
  rm -f "$payload"
  echo "  ✓ $name ($kind)"
}

# ---------------------------------------------------------------------------
# Batched 1Password resolution.
#
# `op read` makes one network round-trip per reference, so resolving dozens
# of secrets one-at-a-time dominates the sync wall-clock. `queue_secret`
# records (name, ref) pairs; `flush_secrets` resolves the whole batch in a
# SINGLE `op inject` call, then pushes each value to GitHub. This cuts the
# 1Password round-trips from O(secrets) to O(1) per flush.
#
# Each reference is wrapped in sentinel lines so multi-line values (e.g. the
# GCP service-account JSON) round-trip intact. The sentinel carries a
# per-run nonce so it can never collide with secret content.
# ---------------------------------------------------------------------------

_OP_NAMES=()
_OP_REFS=()

# queue_secret NAME 'op://vault/item/field'
queue_secret() {
  _OP_NAMES+=("$1")
  _OP_REFS+=("$2")
}

flush_secrets() {
  [ "${#_OP_NAMES[@]}" -gt 0 ] || return 0

  local nonce="op_$$_${RANDOM}${RANDOM}"
  local b="@@${nonce}_B@@"
  local e="@@${nonce}_E@@"
  local tmpl resolved i
  tmpl=$(mktemp)
  resolved=$(mktemp)

  for i in "${!_OP_NAMES[@]}"; do
    printf '%s%s\n%s\n%s\n' "$b" "${_OP_NAMES[$i]}" "${_OP_REFS[$i]}" "$e" >>"$tmpl"
  done

  # Single round-trip resolves every queued reference at once. (No --account:
  # matches the rest of this script — locally the only account is plotco; in
  # CI the OP_SERVICE_ACCOUNT_TOKEN implies it.)
  if ! op inject -i "$tmpl" >"$resolved"; then
    rm -f "$tmpl" "$resolved"
    echo "  ✗ op inject failed resolving ${#_OP_NAMES[@]} references" >&2
    return 1
  fi
  rm -f "$tmpl"

  local name="" val="" in_block=0 first=1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
    "$b"*)
      name="${line#"$b"}"
      val=""
      in_block=1
      first=1
      ;;
    "$e")
      # Strip trailing newlines so the value is byte-identical to the old
      # `value=$(op read …)` path (command substitution drops them).
      while [ "${val: -1}" = $'\n' ]; do val="${val%$'\n'}"; done
      set_secret "$name" "$val"
      in_block=0
      ;;
    *)
      if [ "$in_block" = 1 ]; then
        if [ "$first" = 1 ]; then
          val="$line"
          first=0
        else
          val="$val"$'\n'"$line"
        fi
      fi
      ;;
    esac
  done <"$resolved"
  rm -f "$resolved"

  _OP_NAMES=()
  _OP_REFS=()
}

# ---------------------------------------------------------------------------
# App config secrets: read from .env and .env.production templates.
# .env.production overrides .env when both define the same key.
# ---------------------------------------------------------------------------

echo "=== Syncing app config secrets from .env templates ==="

declare -A OP_REFS
declare -A PLAIN_VALS

for file in "$REPO_ROOT/.env" "$REPO_ROOT/.env.production"; do
  [ -f "$file" ] || continue
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
    \#* | '') continue ;;
    *=op://*)
      name="${line%%=*}"
      ref="${line#*=}"
      ref="${ref//\$ENV/Production}" # resolve $ENV placeholder
      OP_REFS["$name"]="$ref"
      unset "PLAIN_VALS[$name]" 2>/dev/null || true
      ;;
    *=*)
      name="${line%%=*}"
      value="${line#*=}"
      PLAIN_VALS["$name"]="$value"
      unset "OP_REFS[$name]" 2>/dev/null || true
      ;;
    esac
  done <"$file"
done

for name in "${!OP_REFS[@]}"; do
  queue_secret "$name" "${OP_REFS[$name]}"
done
flush_secrets

# Plain values from templates are not synced — they're committed to the repo
# and don't need to be in GitHub secrets.

# ---------------------------------------------------------------------------
# CI-only secrets: deploy credentials and signing assets.
# These don't belong in app env templates; add new ones here directly.
# ---------------------------------------------------------------------------

echo "=== Syncing CI-only secrets ==="

# Scalar (string-valued) refs are queued and resolved together in one
# `op inject` at the end of this section. Binary/file attachments stay on
# `set_file_secret` (op read --out-file) — they can't ride a text template.

# Cloudflare (deploy auth — not app config)
queue_secret CF_API_TOKEN 'op://Production/Cloudflare/credential'
queue_secret CF_ACCOUNT_ID 'op://Production/Cloudflare/username'
queue_secret CF_R2_ACCESS_KEY_ID 'op://Production/cloudflare/build uploads/r2 access key id'
queue_secret CF_R2_SECRET_ACCESS_KEY 'op://Production/cloudflare/build uploads/r2 secret access key'
queue_secret CF_R2_BUCKET_NAME 'op://Production/cloudflare/build uploads/r2 bucket name'

# Database migration (CI runner credentials). GCP_SA_KEY is multi-line JSON —
# the sentinel-wrapped template in flush_secrets preserves its newlines.
queue_secret GCP_SA_KEY 'op://Production/Database/service account/plot-ci-migrator-key.json'
queue_secret MIGRATOR_PASSWORD 'op://Production/Database/migrator/password'

# Shorebird OTA
queue_secret SHOREBIRD_TOKEN 'op://Production/Shorebird/credential'

# Twist deploy CLI (Plot publisher token, minted by the
# 20260416152401_remove_twist_admin migration; retrieve via
# SELECT token FROM token WHERE name = 'Plot Publisher (CI)' AND archived_at IS NULL;)
queue_secret PLOT_DEPLOY_TOKEN 'op://Production/Plot Publisher CI/credential'

# Apple code signing
# NOTE: `distribution p12` and `installer p12` are STRING fields that already
# contain the base64-encoded p12. Pass them through unchanged — running them
# through set_file_secret would re-encode and break decoding in CI.
queue_secret APPLE_DIST_CERT_BASE64 'op://Production/Apple/Signing/distribution p12'
queue_secret APPLE_DIST_CERT_PASSWORD 'op://Production/Apple/Signing/distribution password'
queue_secret APPLE_INSTALLER_CERT_BASE64 'op://Production/Apple/Signing/installer p12'
queue_secret APPLE_INSTALLER_CERT_PASSWORD 'op://Production/Apple/Signing/installer password'
set_file_secret ASC_API_KEY_P8_BASE64 "op://Production/Apple/App Store Connect/key.p8"
queue_secret ASC_API_KEY_ID 'op://Production/Apple/App Store Connect/key id'
queue_secret ASC_API_ISSUER_ID 'op://Production/Apple/App Store Connect/issuer id'
set_file_secret IOS_MOBILEPROVISION_BASE64 "op://Production/Apple/Signing/ios.mobileprovision"
set_file_secret IOS_SHARE_EXT_MOBILEPROVISION_BASE64 "op://Production/Apple/Signing/ios-share-extension.mobileprovision"
set_file_secret MACOS_PROVISIONPROFILE_BASE64 "op://Production/Apple/Signing/macos.provisionprofile"

# Android signing
set_file_secret ANDROID_KEYSTORE_BASE64 "op://Production/Android Signing/plot-release.jks"
queue_secret ANDROID_KEYSTORE_PASSWORD 'op://Production/Android Signing/keystore_password'
queue_secret ANDROID_KEY_PASSWORD 'op://Production/Android Signing/key_password'
set_file_secret PLAY_STORE_SERVICE_KEY "op://Production/Android Signing/Play Store/play-deployer-service-key.json"

# Firebase
set_file_secret FIREBASE_ANDROID_GOOGLE_SERVICES "op://Production/Firebase Cloud Messaging/android/google-services.json"
set_file_secret FIREBASE_IOS_GOOGLE_SERVICE_INFO "op://Production/Firebase Cloud Messaging/apple/GoogleService-Info.plist"

# Windows signing
set_file_secret WINDOWS_CODESIGN_PFX_BASE64 "op://Production/Windows Signing/plot-codesign.pfx"
queue_secret WINDOWS_CODESIGN_PASSWORD 'op://Production/Windows Signing/password'

# Microsoft Store publishing (msstore — Partner Center submission API).
# Entra app "Windows Store" associated with Partner Center under the Manager
# role. AZURE_AD_APPLICATION_SECRET is the client secret *Value* (the long
# string from Entra's "Value" column, held in the item's password field) — not
# the Secret ID. Consumed by the release-windows job in release.yml; see
# docs/windows-store-publishing.md.
queue_secret AZURE_AD_TENANT_ID 'op://Production/Windows Store/Tenant ID'
queue_secret AZURE_AD_APPLICATION_CLIENT_ID 'op://Production/Windows Store/App client ID'
queue_secret AZURE_AD_APPLICATION_SECRET 'op://Production/Windows Store/password'
queue_secret SELLER_ID 'op://Production/Windows Store/Seller ID'

# Resolve all queued CI-only scalar refs in one op inject round-trip.
flush_secrets

# ---------------------------------------------------------------------------
# Flutter app .env (pre-rendered so CI doesn't need 1Password or gen-env)
# ---------------------------------------------------------------------------

echo "=== Generating FLUTTER_ENV_PROD ==="

FLUTTER_DEPLOY_VARS=$(node -e \
  "const p=require('$REPO_ROOT/apps/plot/package.json'); \
   process.stdout.write(p.config?.deploy_vars||'')")

if [ -n "$FLUTTER_DEPLOY_VARS" ]; then
  FLUTTER_ENV=$(cd "$REPO_ROOT/apps/plot" && bash ../../scripts/gen-env production $FLUTTER_DEPLOY_VARS)
  set_secret FLUTTER_ENV_PROD "$FLUTTER_ENV"
fi

# ---------------------------------------------------------------------------
# Cloudflare Worker secret bundles (keyed by worker name).
# Stored as a single WORKER_CONFIGS_JSON so matrix jobs can look up by name.
# ---------------------------------------------------------------------------

echo "=== Generating WORKER_CONFIGS_JSON ==="

CONFIGS="{}"

for worker_dir in "$REPO_ROOT"/workers/*/; do
  worker=$(basename "$worker_dir")
  pkg="$worker_dir/package.json"
  [ -f "$pkg" ] || continue

  DEPLOY_VARS=$(node -e \
    "const p=require('$pkg'); process.stdout.write(p.config?.deploy_vars||'')")
  [ -n "$DEPLOY_VARS" ] || continue

  echo "  Building bundle for $worker..."
  ALL=$(cd "$worker_dir" && bash ../../scripts/gen-env production $DEPLOY_VARS)

  SECRETS_PART=$(printf '%s' "$ALL" | grep -E 'SECRET|KEY|TOKEN' || true)
  SECRETS_JSON=$(printf '%s' "$SECRETS_PART" | bash "$REPO_ROOT/scripts/env-to-json")

  VARS_PART=$(printf '%s' "$ALL" | grep -Ev 'SECRET|KEY|TOKEN' || true)
  VARS_FORMATTED=$(printf '%s' "$VARS_PART" | sed 's/=/:/g' | tr '\n' ' ' | sed 's/ $//')

  CONFIGS=$(printf '%s' "$CONFIGS" | jq \
    --arg w "$worker" \
    --argjson s "$SECRETS_JSON" \
    --arg v "$VARS_FORMATTED" \
    '. + {($w): {"secrets": $s, "vars": $v}}')
done

set_secret WORKER_CONFIGS_JSON "$CONFIGS"

# ---------------------------------------------------------------------------
# Site secret bundle (apps/site deploy vars for Cloudflare Pages)
# ---------------------------------------------------------------------------

echo "=== Generating site secret bundle ==="

SITE_PKG="$REPO_ROOT/apps/site/package.json"
if [ -f "$SITE_PKG" ]; then
  SITE_DEPLOY_VARS=$(node -e \
    "const p=require('$SITE_PKG'); process.stdout.write(p.config?.deploy_vars||'')")

  if [ -n "$SITE_DEPLOY_VARS" ]; then
    ALL=$(cd "$REPO_ROOT/apps/site" && bash ../../scripts/gen-env production $SITE_DEPLOY_VARS)

    SECRETS_PART=$(printf '%s' "$ALL" | grep -E 'SECRET|KEY|TOKEN' || true)
    SECRETS_JSON=$(printf '%s' "$SECRETS_PART" | bash "$REPO_ROOT/scripts/env-to-json")

    VARS_PART=$(printf '%s' "$ALL" | grep -Ev 'SECRET|KEY|TOKEN' || true)
    VARS_FORMATTED=$(printf '%s' "$VARS_PART" | sed 's/=/:/g' | tr '\n' ' ' | sed 's/ $//')

    set_secret SITE_SECRETS_JSON "$SECRETS_JSON"
    set_secret SITE_VARS "$VARS_FORMATTED"
  fi
fi

echo "=== Done ==="

if [ "$MODE" = hash ]; then
  # Emit the single content hash on the reserved stdout (fd 3).
  sort "$HASH_BUF" | sha256sum | cut -d' ' -f1 >&3
  rm -f "$HASH_BUF"
fi
