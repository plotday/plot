#!/usr/bin/env bash
set -euo pipefail

# Set up an isolated PostgreSQL database for a worktree.
# Finds an available port, starts a Docker container, applies migrations,
# and writes a marker file for cleanup by worktree-db-remove.
#
# Must be run from within a worktree directory.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKTREE_DIR="$(pwd)"
DB_DIR="$WORKTREE_DIR/libs/db"

if [[ ! -f "$DB_DIR/docker-compose.yml" ]]; then
  echo "Error: Must be run from a worktree root (libs/db/docker-compose.yml not found)"
  exit 1
fi

# Derive compose project name from the worktree directory name
BRANCH_NAME="$(basename "$WORKTREE_DIR")"
PROJECT_NAME="plot-db-${BRANCH_NAME}"

# Find an available port starting from 54330
PORT=54330
while lsof -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; do
  ((PORT++))
  if [[ $PORT -gt 54399 ]]; then
    echo "Error: No available ports in range 54330-54399"
    exit 1
  fi
done

# Find an available mailpit port starting from 54430
MAILPIT_PORT=54430
while lsof -iTCP:"$MAILPIT_PORT" -sTCP:LISTEN >/dev/null 2>&1; do
  ((MAILPIT_PORT++))
  if [[ $MAILPIT_PORT -gt 54499 ]]; then
    echo "Error: No available mailpit ports in range 54430-54499"
    exit 1
  fi
done

echo "Using port $PORT for worktree database ($PROJECT_NAME)"

# Start the container with env vars for port mapping
echo "Starting database container..."
DATABASE_PORT="$PORT" MAILPIT_PORT="$MAILPIT_PORT" COMPOSE_PROJECT_NAME="$PROJECT_NAME" \
  docker compose -f "$DB_DIR/docker-compose.yml" up -d db

# Wait for readiness
echo "Waiting for PostgreSQL..."
"$DB_DIR/scripts/wait-for-pg.sh" 127.0.0.1 "$PORT"

# Update libs/db/.env.development with the new port
if [[ -f "$DB_DIR/.env.development" ]]; then
  # Replace the DATABASE_URL port
  sed -i '' "s|127\.0\.0\.1:54322|127.0.0.1:${PORT}|g" "$DB_DIR/.env.development"
  sed -i '' "s|localhost:54322|localhost:${PORT}|g" "$DB_DIR/.env.development"
  echo "Updated libs/db/.env.development to use port $PORT"
fi

# Write overrides to .env.development.local (gitignored, not a committed file)
LOCAL_ENV="$WORKTREE_DIR/.env.development.local"
cat > "$LOCAL_ENV" <<LOCALEOF
DATABASE_PORT=${PORT}
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:${PORT}/postgres
LOCALEOF
echo "Wrote $LOCAL_ENV with port $PORT"

# Apply migrations
echo "Applying migrations..."
# apply-migrations script appends ?sslmode=disable, so don't include it here
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:${PORT}/postgres" \
  pnpm --filter @plotday/db run apply-migrations

# Set DATABASE_URL in Claude Code session env so pnpm commands auto-approve
CLAUDE_SETTINGS="$WORKTREE_DIR/.claude/settings.local.json"
DB_URL="postgresql://postgres:postgres@127.0.0.1:${PORT}/postgres"
if [[ -f "$CLAUDE_SETTINGS" ]]; then
  # Merge env.DATABASE_URL into existing settings
  jq --arg url "$DB_URL" '.env.DATABASE_URL = $url' "$CLAUDE_SETTINGS" > "${CLAUDE_SETTINGS}.tmp" \
    && mv "${CLAUDE_SETTINGS}.tmp" "$CLAUDE_SETTINGS"
  echo "Updated $CLAUDE_SETTINGS with DATABASE_URL"
elif [[ -d "$WORKTREE_DIR/.claude" ]]; then
  # Create settings file with just the env block
  echo "{\"env\":{\"DATABASE_URL\":\"$DB_URL\"}}" | jq . > "$CLAUDE_SETTINGS"
  echo "Created $CLAUDE_SETTINGS with DATABASE_URL"
fi

# Update DATABASE_URL in all .dev.vars files that reference it
while IFS= read -r devvars; do
  if grep -q "DATABASE_URL" "$devvars"; then
    sed -i '' "s|DATABASE_URL=.*|DATABASE_URL=${DB_URL}|" "$devvars"
    echo "Updated DATABASE_URL in ${devvars#$WORKTREE_DIR/}"
  fi
done < <(find "$WORKTREE_DIR" -name ".dev.vars*" -not -path "*/node_modules/*" -not -path "*/.worktrees/*")

# Write marker file for cleanup
cat > "$WORKTREE_DIR/.worktree-db" <<EOF
PORT="$PORT"
MAILPIT_PORT="$MAILPIT_PORT"
PROJECT_NAME="$PROJECT_NAME"
DB_DIR="$DB_DIR"
EOF

echo ""
echo "Worktree database ready:"
echo "  Port: $PORT"
echo "  Project: $PROJECT_NAME"
echo "  URL: postgres://postgres:postgres@127.0.0.1:${PORT}/postgres"
