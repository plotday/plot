#!/usr/bin/env bash

set -euo pipefail

ENV=${ENV:-production}
RELEASE=${GITHUB_SHA:-$(git rev-parse HEAD)}
PACKAGE=$(echo $npm_package_name | cut -d'/' -f2)
definitions="ENV:\"$ENV\" RELEASE:\"$RELEASE\" PACKAGE:\"$PACKAGE\""

if [[ -v SENTRY_AUTH_TOKEN_CF ]]; then
  echo Setting SENTRY_AUTH_TOKEN
  export SENTRY_AUTH_TOKEN="$SENTRY_AUTH_TOKEN_CF"
elif [[ -n "$(which op)" ]]; then
  export SENTRY_AUTH_TOKEN=$(op read op://Development/Sentry/credential)
fi

if [[ -v DEPLOY_VARS ]]; then
  VARS="--var $DEPLOY_VARS"
else
  VARS="--keep-vars"
fi

wrangler deploy --dry-run --outdir build --define $definitions
sentry-cli sourcemaps inject --org plotday --project workers build
wrangler deploy --no-bundle build/index.js --define $definitions $VARS
sentry-cli sourcemaps upload --org plotday --project workers --release=$RELEASE --dist=$PACKAGE build
