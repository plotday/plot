#!/usr/bin/env bash

set -euo pipefail

ENV=${ENV:-production}
RELEASE=${GITHUB_SHA:-$(git rev-parse HEAD)}
definitions="ENV:\"$ENV\" RELEASE:\"$RELEASE\""

if [[ -v SENTRY_AUTH_TOKEN_CF ]]; then
  export SENTRY_AUTH_TOKEN="$SENTRY_AUTH_TOKEN_CF"
fi

wrangler deploy --dry-run --outdir build --define $definitions
sentry-cli sourcemaps inject --org plotday --project workers build
wrangler deploy --keep-vars --no-bundle --define $definitions
sentry-cli sourcemaps upload --org plotday --project workers --release=$RELEASE --dist=$PACKAGE build
