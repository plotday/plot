#!/bin/bash

set -euo pipefail

RELEASE=${GITHUB_SHA:-dev}
PACKAGE=$(echo $npm_package_name | cut -d'/' -f2)
ENV=${ENV:-production}
DEPLOY_VARS=$($(dirname "$0")/gen-env $ENV RELEASE=$RELEASE PACKAGE=$PACKAGE | sed 's/=\([^=]*\)$/:\1/')
export SENTRY_AUTH_TOKEN=$(op read op://Development/Sentry/credential)

wrangler deploy --dry-run --outdir build
sentry-cli sourcemaps inject --org plotday --project workers build
wrangler deploy --var $DEPLOY_VARS --no-bundle build/index.js
sentry-cli sourcemaps upload --org plotday --project workers --release=$RELEASE --dist=$PACKAGE build
