#!/bin/bash
set -euo pipefail

# Release Android app via Shorebird and upload to Google Play (internal testing).
#
# Prerequisites:
#   - Shorebird CLI installed
#   - Fastlane installed (gem install fastlane)
#   - Google Play service key in 1Password (op://Production/Android Signing/Play Store/)
#   - Android signing keystore configured (key.properties)
#   - Run `pnpm get-env` first to fetch credentials

cd "$(dirname "$0")/../apps/plot"

AAB_PATH="build/app/outputs/bundle/release/app-release.aab"
SERVICE_KEY="android/play-deployer-service-key.json"

# --- Bump build number ---

CURRENT_VERSION=$(grep '^version:' pubspec.yaml | sed 's/version: //' | tr -d ' ')
VERSION_NAME=$(echo "$CURRENT_VERSION" | cut -d'+' -f1)
BUILD_NUMBER=$(echo "$CURRENT_VERSION" | cut -d'+' -f2)
NEW_BUILD_NUMBER=$((BUILD_NUMBER + 1))
NEW_VERSION="${VERSION_NAME}+${NEW_BUILD_NUMBER}"

echo "Bumping version: ${CURRENT_VERSION} → ${NEW_VERSION}"
sed -i '' "s/version: .*/version: ${NEW_VERSION}/" pubspec.yaml

# --- Check prerequisites ---

if [ ! -f "${SERVICE_KEY}" ]; then
  echo ""
  echo "ERROR: Google Play service key not found at ${SERVICE_KEY}"
  echo "Run 'pnpm get-env' first to fetch it from 1Password."
  exit 1
fi

if ! command -v fastlane &> /dev/null; then
  echo ""
  echo "ERROR: fastlane not found"
  echo "Install it: gem install fastlane"
  exit 1
fi

echo "Prerequisites OK."

# --- Build with Shorebird ---

echo ""
echo "=== Building with Shorebird ==="

restore_env() {
  pnpm set-env dev
}
trap restore_env EXIT

pnpm set-env prod
flutter pub run build_runner build --delete-conflicting-outputs
shorebird release android

if [ ! -f "${AAB_PATH}" ]; then
  echo "ERROR: AAB not found at ${AAB_PATH}"
  exit 1
fi

# --- Upload to Google Play ---

echo ""
echo "=== Uploading to Google Play (internal testing) ==="

cd android
fastlane beta

echo ""
echo "Upload complete! Version ${NEW_VERSION} submitted to Google Play internal testing."
