#!/bin/bash
set -euo pipefail

# Release macOS app via Shorebird and upload to App Store Connect.
#
# Prerequisites:
#   - Shorebird CLI installed
#   - "Apple Distribution" certificate in Keychain
#   - "3rd Party Mac Developer Installer" certificate in Keychain
#   - App Store Connect API key in 1Password (op://Production/Apple/App Store Connect/)
#   - Mac App Store provisioning profile in 1Password (op://Production/Apple/Signing/macos.provisionprofile)
#   - Run `pnpm get-env` first to fetch the API key .p8 file

TEAM_NAME="Plot Technologies Inc."
TEAM_ID="789MAH2W6P"
APP_CERT="Apple Distribution: ${TEAM_NAME} (${TEAM_ID})"
INSTALLER_CERT="3rd Party Mac Developer Installer: ${TEAM_NAME} (${TEAM_ID})"
APP_NAME="Plot"
ENTITLEMENTS="macos/Runner/Release.entitlements"

cd "$(dirname "$0")/../apps/plot"

BUILD_DIR="build/macos/Build/Products/Release"
APP_PATH="${BUILD_DIR}/${APP_NAME}.app"
PKG_PATH="${BUILD_DIR}/${APP_NAME}.pkg"

# --- Bump build number ---

CURRENT_VERSION=$(grep '^version:' pubspec.yaml | sed 's/version: //' | tr -d ' ')
VERSION_NAME=$(echo "$CURRENT_VERSION" | cut -d'+' -f1)
BUILD_NUMBER=$(echo "$CURRENT_VERSION" | cut -d'+' -f2)
NEW_BUILD_NUMBER=$((BUILD_NUMBER + 1))
NEW_VERSION="${VERSION_NAME}+${NEW_BUILD_NUMBER}"

echo "Bumping version: ${CURRENT_VERSION} → ${NEW_VERSION}"
sed -i '' "s/version: .*/version: ${NEW_VERSION}/" pubspec.yaml

# --- Check prerequisites ---

echo "Checking signing certificates..."

if ! security find-identity -v | grep -q "Apple Distribution"; then
  echo ""
  echo "ERROR: Missing Apple Distribution certificate"
  echo ""
  echo "To install it:"
  echo "  1. Open Xcode → Settings → Accounts → Manage Certificates"
  echo "  2. Click + → Apple Distribution"
  exit 1
fi

if ! security find-identity -v | grep -q "3rd Party Mac Developer Installer"; then
  echo ""
  echo "ERROR: Missing 3rd Party Mac Developer Installer certificate"
  echo ""
  echo "To install it:"
  echo "  1. Open Xcode → Settings → Accounts → Manage Certificates"
  echo "  2. Click + → Mac Installer Distribution"
  exit 1
fi

echo "Certificates found."

# Read App Store Connect API credentials from 1Password
echo "Reading App Store Connect credentials from 1Password..."
ASC_KEY_ID=$(op read "op://Production/Apple/App Store Connect/key id" --account plotco)
ASC_ISSUER_ID=$(op read "op://Production/Apple/App Store Connect/issuer id" --account plotco)
ASC_KEY_FILE="$HOME/.appstoreconnect/private_keys/AuthKey_${ASC_KEY_ID}.p8"

if [ ! -f "${ASC_KEY_FILE}" ]; then
  echo "ERROR: API key file not found at ${ASC_KEY_FILE}"
  echo "Run 'pnpm get-env' first to fetch it from 1Password."
  exit 1
fi

# Fetch distribution provisioning profile from 1Password
echo "Fetching distribution provisioning profile..."
PROVISION_PROFILE="/tmp/plot-macos-distribution.provisionprofile"
op read "op://Production/Apple/Signing/macos.provisionprofile" \
  --account plotco \
  --out-file "${PROVISION_PROFILE}" \
  --force

echo "Credentials ready."

# --- Build with Shorebird ---

echo ""
echo "=== Building with Shorebird ==="

restore_env() {
  pnpm set-env dev
}
trap restore_env EXIT

pnpm set-env prod
flutter pub run build_runner build --delete-conflicting-outputs
shorebird release macos

if [ ! -d "${APP_PATH}" ]; then
  echo "ERROR: Build not found at ${APP_PATH}"
  exit 1
fi

# --- Re-sign for App Store distribution ---
#
# Shorebird builds with development signing. App Store Connect requires
# a distribution provisioning profile and distribution certificate.
# We replace the embedded provisioning profile and re-sign the app.

echo ""
echo "=== Signing for Mac App Store ==="

# Embed the distribution provisioning profile
cp "${PROVISION_PROFILE}" "${APP_PATH}/Contents/embedded.provisionprofile"

# Re-sign all nested frameworks and dylibs
find "${APP_PATH}/Contents/Frameworks" \( -name "*.dylib" -o -name "*.framework" \) -print0 | while IFS= read -r -d '' file; do
  codesign --force --sign "${APP_CERT}" --timestamp "${file}" 2>/dev/null || true
done

# Re-sign the main app bundle with entitlements
codesign --force --sign "${APP_CERT}" \
  --entitlements "${ENTITLEMENTS}" \
  --timestamp \
  --options runtime \
  "${APP_PATH}"

echo "Verifying signature..."
codesign --verify --verbose "${APP_PATH}"

# --- Package as .pkg ---

echo ""
echo "=== Creating installer package ==="

productbuild \
  --sign "${INSTALLER_CERT}" \
  --component "${APP_PATH}" /Applications \
  "${PKG_PATH}"

echo "Package created: ${PKG_PATH}"

# --- Upload to App Store Connect ---

echo ""
echo "=== Uploading to App Store Connect ==="

xcrun altool --upload-app \
  --type macos \
  -f "${PKG_PATH}" \
  --apiKey "${ASC_KEY_ID}" \
  --apiIssuer "${ASC_ISSUER_ID}"

echo ""
echo "Upload complete! Version ${NEW_VERSION} submitted to App Store Connect."
