#!/usr/bin/env bash

# Given .env templates (.env*.1p), generated an .env file:
# 1. replacing vars specified in workspace-level .env files
# 2. replacing 1Password secret references

export ENV=$1
case $ENV in
  development)
    ;;
  production)
    ;;
  *)
    echo "Usage: $0 <development|production> [VAR]+"
    exit 1
    ;;
esac

shift
VARS="$@ $npm_package_deploy_vars"

filter_existing_paths() {
  local paths="$@"
  local existing_paths=""

  # Iterate over each path
  for path in $paths; do
    # Check if the path exists
    if [ -e "$path" ]; then
      # Append space to separate existing paths
      existing_paths+="$path "
    fi
  done

  # Trim trailing space if necessary before returning
  echo "${existing_paths% }"
}

WORKSPACE_PATH="$(dirname -- "${BASH_SOURCE[0]}")/.."
WORKSPACE_FILES=$(filter_existing_paths $WORKSPACE_PATH/.env $WORKSPACE_PATH/.env.local $WORKSPACE_PATH/.env.$ENV $WORKSPACE_PATH/.env.$ENV.local)

declare -A VALUES
for file in $WORKSPACE_FILES; do
  while IFS= read -r line; do
    if [[ $line =~ ^([a-zA-Z_][a-zA-Z0-9_]*)= ]]; then
      var_name="${line%=*}"
      var_value="${line#*=}"
      VALUES[$var_name]=$var_value
    fi
  done < "$file"
done

fail=0
for var in $VARS; do
  var_ref=
  var_value=
  # Hardcoded values
  if [[ "$var" =~ ^([^=:]*)= ]]; then
    var_name="${BASH_REMATCH[1]}"
    var_value="${var#*=}"
  # Aliases
  elif [[ "$var" =~ ^([^=:]*): ]]; then
    var_name="${BASH_REMATCH[1]}"
    var_ref=${var#*:}
  # References
  else
    var_name=$var
    var_ref=$var
  fi
  if [[ -n "$var_ref" && -n "${VALUES[$var_ref]}" ]]; then
    var_value=${VALUES[$var_ref]}
  elif [[ -z "$var_value" ]]; then
    echo "!!! Environment variable $var not set" >&2
    fail=1
  fi
  result="${result}${var_name}=${var_value}"$'\n'
done
if [ $fail -eq 1 ]; then
  exit 1
fi

printf "%s" "$result" | op inject
