#!/usr/bin/env bash

# Output a combined .env file by:
# 1. Taking root .env, .env.local, .env.<ENV>, and .env.<ENV>.local files
# 2. Replacing 1Password secret references

export ENV=$1
case $ENV in
development) ;;
production) ;;
*)
  echo "Usage: $0 <development|production> [VAR]+" >&2
  exit 1
  ;;
esac

shift
if [ $# -gt 0 ]; then
  VARS="$@"
else
  VARS="$npm_package_config_deploy_vars"
fi

filter_existing_paths() {
  local paths="$@"
  local existing_paths=""

  # Iterate over each path
  for path in $paths; do
    # Check if the path exists
    if [ -e "$path" ]; then
      # Append space to separate existing paths
      existing_paths="$existing_paths$path "
    fi
  done

  # Remove trailing space
  echo "${existing_paths% }"
}

WORKSPACE_PATH="$(dirname -- "${BASH_SOURCE[0]}")/.."
WORKSPACE_FILES=$(filter_existing_paths $WORKSPACE_PATH/.env $WORKSPACE_PATH/.env.local $WORKSPACE_PATH/.env.$ENV $WORKSPACE_PATH/.env.$ENV.local)

NAMES=()
VALUES=()

# Parse .env files into arrays
for file in $WORKSPACE_FILES; do
  while IFS= read -r line; do
    case "$line" in
    [a-zA-Z_]*=*)
      var_name="${line%%=*}"
      var_value="${line#*=}"
      NAMES[${#NAMES[@]}]="$var_name"
      VALUES[${#VALUES[@]}]="$var_value"
      ;;
    esac
  done <"$file"
done

# Function to get a variable's value by name
# Returns the LAST match to ensure more specific files override less specific ones
get_var_value() {
  local search="$1"
  local result=""
  local found=0
  local i=0

  # Scan all entries and keep the LAST match
  while [ $i -lt ${#NAMES[@]} ]; do
    if [ "${NAMES[$i]}" = "$search" ]; then
      result="${VALUES[$i]}"
      found=1
    fi
    i=$((i + 1))
  done

  if [ $found -eq 1 ]; then
    echo "$result"
    return 0
  fi
  return 1
}

fail=0
result=""
seen_vars=""

for var in $VARS; do
  var_ref=
  var_value=
  # Hardcoded values
  if [[ "$var" =~ ^([^=:]*)= ]]; then
    var_name="${BASH_REMATCH[1]}"
    var_value="${var#*=}"
  # Aliases
  elif [[ "$var" =~ ^([^=:]*): ]]; then
    var_name="${BASH_REMATCH[1]}"
    var_ref=${var#*:}
  # References
  else
    var_name=$var
    var_ref=$var
  fi

  # Skip duplicate var names
  case " $seen_vars " in
    *" $var_name "*) continue ;;
  esac
  seen_vars="$seen_vars $var_name"

  if [ -n "$var_ref" ]; then
    got_val=$(get_var_value "$var_ref")
    if [ $? -eq 0 ]; then
      var_value="$got_val"
    else
      var_value=""
    fi
  fi

  if [ -z "$var_value" ]; then
    echo "!!! Environment variable $var not set" >&2
    fail=1
  fi
  result="${result}${var_name}=${var_value}"$'\n'
done

if [ $fail -eq 1 ]; then
  exit 1
fi

# Inject 1Password references (skip if none present, so CI works without 1Password
# for env files that contain only plain values).
if printf "%s" "$result" | grep -q "op://"; then
  injected=$(printf "%s" "$result" | op --account plotco inject)
else
  injected="$result"
fi

# Normalize multi-line values (e.g. .p8 file attachments) into single-line
# key=value pairs with literal "\n" escapes. Required because dotenv parsers
# (.dev.vars loaders, env-to-json piped to wrangler secret bulk) treat each
# physical line as a new key=value. Without this, a multi-line PEM gets
# truncated after the BEGIN line and every subsequent line of the key is
# misread as its own secret name. Runtime code can unescape with
# .replace(/\\n/g, "\n"); JSON consumers (env-to-json) get correct newlines
# automatically since JSON itself interprets "\n" as a real newline.
printf "%s" "$injected" | awk '
  /^[A-Z_][A-Z0-9_]*=/ {
    if (NR > 1) print acc
    acc = $0
    next
  }
  { acc = acc "\\n" $0 }
  END { if (acc != "") print acc }
'

# Generate key.properties for Android production builds
if [ "$ENV" = "production" ]; then
  KEY_PROPERTIES_TEMPLATE="$WORKSPACE_PATH/apps/plot/android/key.properties.template"
  KEY_PROPERTIES_OUTPUT="$WORKSPACE_PATH/apps/plot/android/key.properties"

  if [ -f "$KEY_PROPERTIES_TEMPLATE" ]; then
    echo "Generating key.properties from template..." >&2
    cat "$KEY_PROPERTIES_TEMPLATE" | op --account plotco inject >"$KEY_PROPERTIES_OUTPUT"
    if [ $? -eq 0 ]; then
      echo "✓ key.properties generated successfully" >&2
    else
      echo "✗ Failed to generate key.properties" >&2
      exit 1
    fi
  fi

  # Fetch Android signing keystore
  KEYSTORE_OUTPUT="$WORKSPACE_PATH/apps/plot/plot-release.jks"
  if [ ! -f "$KEYSTORE_OUTPUT" ]; then
    echo "Fetching Android signing keystore from 1Password..." >&2
    op read "op://Production/Android Signing/plot-release.jks" \
      --account plotco \
      --out-file "$KEYSTORE_OUTPUT" \
      --file-mode 0600 > /dev/null
    if [ $? -eq 0 ]; then
      echo "✓ Android signing keystore fetched successfully" >&2
    else
      echo "✗ Failed to fetch Android signing keystore" >&2
      exit 1
    fi
  else
    echo "✓ Android signing keystore already exists" >&2
  fi

  # Fetch Google Play API JSON key
  PLAY_API_KEY_OUTPUT="$WORKSPACE_PATH/apps/plot/android/play-deployer-service-key.json"
  if [ ! -f "$PLAY_API_KEY_OUTPUT" ]; then
    echo "Fetching Google Play API key from 1Password..." >&2
    op read "op://Production/Android Signing/Play Store/play-deployer-service-key.json" \
      --account plotco \
      --out-file "$PLAY_API_KEY_OUTPUT" \
      --file-mode 0600 > /dev/null
    if [ $? -eq 0 ]; then
      echo "✓ Google Play API key fetched successfully" >&2
    else
      echo "✗ Failed to fetch Google Play API key" >&2
      exit 1
    fi
  else
    echo "✓ Google Play API key already exists" >&2
  fi

  # Fetch Firebase config for Android (google-services.json)
  GOOGLE_SERVICES_OUTPUT="$WORKSPACE_PATH/apps/plot/android/app/google-services.json"
  if [ ! -f "$GOOGLE_SERVICES_OUTPUT" ]; then
    echo "Fetching Firebase google-services.json from 1Password..." >&2
    op read "op://Production/Firebase Cloud Messaging/android/google-services.json" \
      --account plotco \
      --out-file "$GOOGLE_SERVICES_OUTPUT" \
      --file-mode 0600 > /dev/null
    if [ $? -eq 0 ]; then
      echo "✓ Firebase google-services.json fetched successfully" >&2
    else
      echo "✗ Failed to fetch Firebase google-services.json" >&2
      exit 1
    fi
  else
    echo "✓ Firebase google-services.json already exists" >&2
  fi

  # Fetch Firebase config for iOS (GoogleService-Info.plist)
  GOOGLE_SERVICE_INFO_OUTPUT="$WORKSPACE_PATH/apps/plot/ios/Runner/GoogleService-Info.plist"
  if [ ! -f "$GOOGLE_SERVICE_INFO_OUTPUT" ]; then
    echo "Fetching Firebase GoogleService-Info.plist from 1Password..." >&2
    op read "op://Production/Firebase Cloud Messaging/apple/GoogleService-Info.plist" \
      --account plotco \
      --out-file "$GOOGLE_SERVICE_INFO_OUTPUT" \
      --file-mode 0600 > /dev/null
    if [ $? -eq 0 ]; then
      echo "✓ Firebase GoogleService-Info.plist fetched successfully" >&2
    else
      echo "✗ Failed to fetch Firebase GoogleService-Info.plist" >&2
      exit 1
    fi
  else
    echo "✓ Firebase GoogleService-Info.plist already exists" >&2
  fi

  # Fetch App Store Connect API key for macOS uploads
  ASC_KEY_DIR="$HOME/.appstoreconnect/private_keys"
  ASC_KEY_FILE="$ASC_KEY_DIR/AuthKey_$(op read 'op://Production/Apple/App Store Connect/key id' --account plotco).p8"
  if [ ! -f "$ASC_KEY_FILE" ]; then
    echo "Fetching App Store Connect API key from 1Password..." >&2
    mkdir -p "$ASC_KEY_DIR"
    op read "op://Production/Apple/App Store Connect/key.p8" \
      --account plotco \
      --out-file "$ASC_KEY_FILE" \
      --file-mode 0600 > /dev/null
    if [ $? -eq 0 ]; then
      echo "✓ App Store Connect API key fetched successfully" >&2
    else
      echo "✗ Failed to fetch App Store Connect API key" >&2
      exit 1
    fi
  else
    echo "✓ App Store Connect API key already exists" >&2
  fi

  # Fetch Windows signing certificate
  WINDOWS_CERT_OUTPUT="$WORKSPACE_PATH/apps/plot/windows/plot-codesign.pfx"
  if [ ! -f "$WINDOWS_CERT_OUTPUT" ]; then
    echo "Fetching Windows signing certificate from 1Password..." >&2
    mkdir -p "$(dirname "$WINDOWS_CERT_OUTPUT")"
    op read "op://Production/Windows Signing/plot-codesign.pfx" \
      --account plotco \
      --out-file "$WINDOWS_CERT_OUTPUT" \
      --file-mode 0600 > /dev/null
    if [ $? -eq 0 ]; then
      echo "✓ Windows signing certificate fetched successfully" >&2
    else
      echo "✗ Failed to fetch Windows signing certificate" >&2
      exit 1
    fi
  else
    echo "✓ Windows signing certificate already exists" >&2
  fi
fi
