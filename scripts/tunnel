#!/usr/bin/env bash

# Cloudflare Tunnel management for development.
# Exposes local API at a per-developer hostname (https://api-<you>.plot.day)
# for webhook testing.
#
# The developer identifier defaults to the first dot-separated segment of
# `whoami` (e.g. macOS account "kris.braun" -> "kris"), which matches the
# firstname@plot.day convention for most machines. Override it if that
# guess is wrong for you:
#   TUNNEL_DEV_NAME=tobin pnpm tunnel:setup

set -euo pipefail

WORKSPACE_PATH="$(cd "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

# When invoked from a git worktree, resolve to the main checkout so every
# worktree shares one config, PID file, and log. Only one tunnel can run
# anyway (single tunnel ID, single localhost:8787 origin).
if GIT_COMMON_DIR=$(git -C "$WORKSPACE_PATH" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  WORKSPACE_PATH="$(dirname "$GIT_COMMON_DIR")"
fi

resolve_dev_name() {
  if [ -n "${TUNNEL_DEV_NAME:-}" ]; then
    printf '%s' "$TUNNEL_DEV_NAME"
    return
  fi

  local raw
  raw="$(whoami | cut -d. -f1)"
  printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-'
}

DEV_NAME="$(resolve_dev_name)"
TUNNEL_NAME="plot-dev-$DEV_NAME"
TUNNEL_HOSTNAME="api-$DEV_NAME.plot.day"

CONFIG_PATH="$WORKSPACE_PATH/.cloudflared/config.yml"
PID_PATH="$WORKSPACE_PATH/.tunnel.pid"
LOG_PATH="$WORKSPACE_PATH/.tunnel.log"

require_config() {
  if [ ! -f "$CONFIG_PATH" ]; then
    echo "Error: Tunnel config not found at $CONFIG_PATH"
    echo "Run: pnpm tunnel:setup"
    exit 1
  fi
}

# The config file is the source of truth for the hostname actually in use
# (it's written once at setup time and doesn't change if TUNNEL_DEV_NAME or
# the git email changes later).
config_hostname() {
  awk -F'hostname:[[:space:]]*' '/hostname:/ { print $2; exit }' "$CONFIG_PATH"
}

start() {
  require_config
  echo "Starting Cloudflare Tunnel ($(config_hostname) → localhost:8787)"
  cloudflared tunnel --config "$CONFIG_PATH" run
}

start_bg() {
  if [ -f "$PID_PATH" ]; then
    PID=$(cat "$PID_PATH")
    if ps -p "$PID" > /dev/null 2>&1; then
      echo "Tunnel already running (PID $PID)"
      return 0
    fi
  fi

  require_config

  echo "Starting Cloudflare Tunnel in background..."
  nohup cloudflared tunnel --config "$CONFIG_PATH" run > "$LOG_PATH" 2>&1 &
  PID=$!
  echo "$PID" > "$PID_PATH"

  # cloudflared can die immediately (bad credentials, port conflict, etc).
  # Verify it's still running before claiming success.
  sleep 1
  if ! ps -p "$PID" > /dev/null 2>&1; then
    rm -f "$PID_PATH"
    echo "Error: Tunnel exited immediately. Last 20 log lines:"
    tail -n 20 "$LOG_PATH" 2>/dev/null | sed 's/^/  /'
    echo ""
    echo "Full log: $LOG_PATH"
    exit 1
  fi

  echo "✓ Tunnel started (PID $PID)"
  echo "  View logs: tail -f $LOG_PATH"
}

stop() {
  if [ ! -f "$PID_PATH" ]; then
    echo "No tunnel PID file found"
    return 0
  fi

  PID=$(cat "$PID_PATH")
  if ps -p "$PID" > /dev/null 2>&1; then
    echo "Stopping tunnel (PID $PID)..."
    kill "$PID"
    rm "$PID_PATH"
    echo "✓ Tunnel stopped"
  else
    echo "Tunnel not running (stale PID file removed)"
    rm "$PID_PATH"
  fi
}

status() {
  if [ ! -f "$PID_PATH" ]; then
    echo "Tunnel: not running"
    return 1
  fi

  PID=$(cat "$PID_PATH")
  if ps -p "$PID" > /dev/null 2>&1; then
    echo "Tunnel: running (PID $PID)"
    if [ -f "$CONFIG_PATH" ]; then
      echo "Public URL: https://$(config_hostname)"
    fi
    echo "Local URL: http://localhost:8787"
    return 0
  else
    echo "Tunnel: not running (stale PID)"
    rm "$PID_PATH"
    return 1
  fi
}

setup() {
  echo "Setting up Cloudflare Tunnel for Plot development"
  echo "Developer: $DEV_NAME  (tunnel: $TUNNEL_NAME, hostname: $TUNNEL_HOSTNAME)"
  echo "Wrong? Rerun with TUNNEL_DEV_NAME=<name> pnpm tunnel:setup"
  echo ""

  # Match the tunnel name exactly - a substring grep would pick the wrong
  # tunnel once more than one developer's "plot-dev-*" tunnel exists.
  EXISTING=$(cloudflared tunnel list 2>/dev/null | awk -v name="$TUNNEL_NAME" '$2 == name { print $1 }')

  if [ -n "$EXISTING" ]; then
    echo "Found existing tunnel: $EXISTING"
    TUNNEL_ID="$EXISTING"
  else
    echo "Creating new tunnel: $TUNNEL_NAME"
    cloudflared tunnel create "$TUNNEL_NAME"
    TUNNEL_ID=$(cloudflared tunnel list | awk -v name="$TUNNEL_NAME" '$2 == name { print $1 }')
  fi

  echo ""
  echo "Tunnel ID: $TUNNEL_ID"

  # Create config directory
  mkdir -p "$WORKSPACE_PATH/.cloudflared"

  # Generate config file
  cat > "$CONFIG_PATH" <<EOF
tunnel: $TUNNEL_ID
credentials-file: $HOME/.cloudflared/$TUNNEL_ID.json

ingress:
  - hostname: $TUNNEL_HOSTNAME
    service: http://localhost:8787
    originRequest:
      noTLSVerify: true
      httpHostHeader: $TUNNEL_HOSTNAME
  - service: http_status:404
EOF

  echo "✓ Config created at $CONFIG_PATH"
  echo ""
  echo "Next steps:"
  echo "1. Create DNS record (if not exists):"
  echo "   cloudflared tunnel route dns $TUNNEL_NAME $TUNNEL_HOSTNAME"
  echo ""
  echo "2. Start tunnel:"
  echo "   pnpm tunnel:start"
}

case "${1:-}" in
  start) start ;;
  start-bg) start_bg ;;
  stop) stop ;;
  status) status ;;
  setup) setup ;;
  *)
    echo "Usage: $0 <start|start-bg|stop|status|setup>"
    echo ""
    echo "  setup     - Create tunnel and generate config"
    echo "  start     - Start tunnel (foreground)"
    echo "  start-bg  - Start tunnel (background daemon)"
    echo "  stop      - Stop background tunnel"
    echo "  status    - Check tunnel status"
    exit 1
    ;;
esac
