{
  "targetDefaults": {
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "cache": true
    },
    "pre-commit:workspace": {
      "cache": true
    },
    "pre-commit": {
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build",
        "lint"
      ],
      "outputs": [
        "{projectRoot}/build"
      ],
      "cache": true
    },
    "deploy": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "test": {
      "cache": true
    },
    "start": {
      "cache": false
    },
    "stop": {
      "cache": false
    },
    "get-env": {
      "cache": false
    },
    "set-env": {
      "cache": false
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main"
}
