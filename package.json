{
  "name": "plot",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "install": "[ -f Gemfile ] && bundle install --quiet || true",
    "bootstrap-unipile-webhooks": "tsx scripts/bootstrap-unipile-webhooks.ts",
    "get-env": "nx run-many -t get-env --exclude plot --parallel=false && bash scripts/get-claude-env",
    "set-env": "nx run-many -t set-env --exclude plot --",
    "build": "nx run-many -t build --exclude plot",
    "deploy:site": "nx deploy @plotday/site",
    "deploy:workers": "nx run-many -t deploy --projects=tag:worker",
    "deploy:workers:vars": "nx run-many -t deploy:vars --projects=tag:worker",
    "deploy:workers:changed": "nx affected -t deploy --projects=tag:worker",
    "connectors:deploy": "bash scripts/deploy-connectors",
    "dev": "pnpm -r run --parallel dev",
    "workers": "pnpm tunnel:start && pnpm --filter @plotday/dev-worker run dev",
    "site": "pnpm --filter @plotday/site run dev",
    "types": "nx run-many -t types --exclude plot",
    "diff-db-schema": "pnpm --filter @plotday/db run diff-db-schema",
    "diff-schema-migrations": "pnpm --filter @plotday/db run diff-schema-migrations",
    "gen-migration": "pnpm --filter @plotday/db run gen-migration",
    "gen-contract-migration": "pnpm --filter @plotday/db run gen-contract-migration",
    "apply-migrations": "pnpm --filter @plotday/db run apply-migrations",
    "gen-seed": "pnpm --filter @plotday/db run gen-seed",
    "pre-commit": "nx run-many -t pre-commit --exclude plot",
    "lint": "pnpm lint:pnpm-installed && pnpm lint:store-metadata && nx run-many -t lint --exclude plot",
    "lint:pnpm-installed": "if [ \"$CI\" = \"true\" ]; then echo 'CI=true; skipping pnpm install (already run by workflow)'; else pnpm install --silent --frozen-lockfile; fi",
    "lint:store-metadata": "node scripts/check-store-metadata.mjs",
    "test": "nx run-many -t test --exclude plot",
    "test:watch": "pnpm -r run test:watch",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:md": "prettier --write \"docs/**/*.md\"",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\"",
    "stop": "nx run-many -t stop --exclude plot",
    "start": "nx run-many -t start --exclude plot",
    "restart": "pnpm stop; pnpm start",
    "update": "pnpm update --latest --recursive",
    "cp-env": "./scripts/cp-env",
    "worktree": "./scripts/worktree",
    "prepare": "husky install",
    "nopy": "nopy",
    "prod-db-connect": "pnpm --filter @plotday/db run prod-db-connect",
    "prod-db-disconnect": "pnpm --filter @plotday/db run prod-db-disconnect",
    "prod-db-logs": "pnpm --filter @plotday/db run prod-db-logs",
    "db:start": "pnpm --filter @plotday/db run start",
    "db:reset": "pnpm --filter @plotday/db run reset",
    "db:migrate": "pnpm --filter @plotday/db run apply-migrations",
    "db:onboarding": "pnpm --filter @plotday/db gen-onboarding",
    "gem-prod": "pnpm prod-db-connect && PGPASSWORD=$(op read --account plotco.1password.com 'op://Production/Database/readonly/password') gemini",
    "tunnel": "bash scripts/tunnel start",
    "tunnel:start": "bash scripts/tunnel start-bg",
    "tunnel:stop": "bash scripts/tunnel stop",
    "tunnel:status": "bash scripts/tunnel status",
    "tunnel:setup": "bash scripts/tunnel setup",
    "test:notifications": "tsx scripts/test-notifications.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@nx/vite": "20.3.0",
    "@plotday/eslint-config-custom": "workspace:*",
    "@posthog/cli": "0.7.22",
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "eslint": "^8.38.0",
    "husky": "^8.0.0",
    "markdownlint-cli2": "^0.20.0",
    "nopy": "^0.2.9",
    "nx": "20.3.0",
    "prettier": "^2.5.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^0.33.0",
    "wrangler": "^4.102.0"
  },
  "nx": {},
  "pnpm": {
    "patchedDependencies": {
      "pg-cloudflare@1.3.0": "patches/pg-cloudflare@1.3.0.patch"
    }
  }
}
