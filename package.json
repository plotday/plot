{
  "name": "@plotday/plot",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "install": "[ \"$CF_PAGES\" = \"1\" ] || npip install",
    "build": "turbo run build",
    "deploy:site": "nx deploy @plotday/site",
    "deploy:workers": "turbo deploy --filter={./workers/*}",
    "deploy:workers:changed": "turbo deploy --filter={./workers/*}...[HEAD^1]",
    "dev": "turbo run dev --concurrency=18",
    "dev:email": "email dev -d libs/email/src -p 8790",
    "gen-types": "turbo run gen-types",
    "diff-db-schema": "pnpm --filter @plotday/db run diff-db-schema",
    "diff-schema-migrations": "pnpm --filter @plotday/db run diff-schema-migrations",
    "diff-schema-db": "pnpm --filter @plotday/db run diff-schema-db",
    "gen-migration": "pnpm --filter @plotday/db run gen-migration",
    "new-migration": "pnpm --filter @plotday/db run new-migration",
    "migrate": "turbo run migrate",
    "lint": "turbo run lint --filter=!@plotday/dev-worker --concurrency=100%",
    "pre-commit": "nx run-many --targets=pre-commit,pre-commit:workspace --exclude @plotday/plot",
    "pre-commit:workspace": "pnpm pre-commit:pnpm-installed",
    "pre-commit:pnpm-installed": "pnpm install --silent --frozen-lockfile",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "stop": "turbo run stop --force",
    "start": "turbo run start --force",
    "restart": "echo .",
    "update": "pnpm update --latest --recursive",
    "prepare": "husky install",
    "tracker:pull": "pnpm --filter @plotday/tracker tracker:pull",
    "nopy": "nopy",
    "npip": "npip"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20230724.0",
    "@plotday/eslint-config-custom": "workspace:*",
    "@sentry/cli": "^2.19.4",
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "@turbo/gen": "^1.9.7",
    "eslint": "^8.38.0",
    "husky": "^8.0.0",
    "nopy": "^0.2.9",
    "prettier": "^2.5.1",
    "react-email": "^1.9.4",
    "turbo": "^1.12.3",
    "typescript": "^5.1.6",
    "vitest": "^0.33.0",
    "wrangler": "^3.60.1",
    "nx": "20.3.0",
    "@nx/vite": "20.3.0"
  },
  "python": {
    "dependencies": {
      "tusker": ""
    }
  },
  "nx": {}
}
