{
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@plotday/web && ln -sfn apps/web/functions functions",
    "deploy:workers": "turbo deploy --filter={./workers/*}",
    "deploy:workers:changed": "turbo deploy --filter={./workers/*}...[HEAD^1]",
    "dev": "turbo run dev --concurrency=12",
    "gen-types": "turbo run gen-types",
    "db-diff": "pnpm --filter @plotday/db run diff",
    "gen-migration": "pnpm --filter @plotday/db run gen-migration",
    "lint": "pnpm install --frozen-lockfile && turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "stop": "turbo run stop --force",
    "start": "turbo run start --force",
    "restart": "echo .",
    "update": "pnpm update --latest --recursive"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20230724.0",
    "@plotday/eslint-config-custom": "workspace:*",
    "@sentry/cli": "^2.19.4",
    "@trivago/prettier-plugin-sort-imports": "^4.1.1",
    "@turbo/gen": "^1.9.7",
    "eslint": "^8.38.0",
    "prettier": "^2.5.1",
    "turbo": "latest",
    "typescript": "^5.1.6",
    "vitest": "^0.33.0",
    "wrangler": "^3.5.0"
  },
  "packageManager": "pnpm@8.6.6",
  "name": "@plotday/plot",
  "pnpm": {
    "patchedDependencies": {
      "@remix-run/dev@1.19.2": "patches/@remix-run__dev@1.19.2.patch"
    }
  }
}
