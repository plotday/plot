{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "composite": false
  },
  "include": [
    "index.ts",
    "sdk/**/*.ts",
    "framework/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cli",
    "bin",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
