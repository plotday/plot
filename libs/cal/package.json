    "test:watch": "export $(pnpm --silent gen-env) && vitest watch"
  },
  "dependencies": {
    "@azure/identity": "^3.2.4",
    "@microsoft/microsoft-graph-client": "^3.0.5",
    "@microsoft/microsoft-graph-types": "^2.35.0",
    "@plotday/tz": "workspace:^",
