{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "display": "Remix",
  "compilerOptions": {
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2021",
      "ES2022.error"
    ],
    "types": [
      "./worker-configuration.d.ts",
    ],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "target": "ES2019",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./app/*"
      ]
    },
    "noEmit": true
  }
}
