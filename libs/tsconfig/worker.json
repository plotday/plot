{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "display": "Cloudflare Worker",
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ES2021",
      "ES2022.error",
      "WebWorker"
    ],
    "module": "ESNext",
    "types": [
      "@cloudflare/workers-types",
      "./worker-configuration.d.ts",
      "../../libs/tsconfig/workers.d.ts"
    ],
    "paths": {
      "@plotday/sdk": [
        "../../libs/agent"
      ]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
  }
}
