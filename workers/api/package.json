{
  "name": "@plotday/api",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "config": {
    "deploy_vars": "DATABASE_URL GCP_PROJECT_ID GCP_PROJECT_NUMBER GCP_SERVICE_ACCOUNT_EMAIL GCP_SERVICE_ACCOUNT_KEY POSTHOG_API_KEY POSTHOG_HOST CLERK_PUBLISHABLE_KEY CLERK_SECRET_KEY CLERK_JWT_KEY CLERK_WEBHOOK_SIGNING_SECRET AUTH_GOOGLE_ID AUTH_GOOGLE_SECRET AUTH_MICROSOFT_ID AUTH_MICROSOFT_SECRET API_ROOT APP_ROOT SITE_ROOT AUTH_GOOGLE_IOS_ID AUTH_GOOGLE_ANDROID_ID AUTH_GOOGLE_DESKTOP_ID AUTH_GOOGLE_DESKTOP_SECRET AUTH_APPLE_NATIVE_CLIENT_ID AUTH_APPLE_WEB_CLIENT_ID AUTH_APPLE_TEAM_ID AUTH_APPLE_KEY_ID AUTH_APPLE_PRIVATE_KEY STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET AI_GATEWAY_ACCOUNT_ID AI_GATEWAY_ID AI_GATEWAY_TOKEN ANTHROPIC_API_KEY GOOGLE_GENERATIVE_AI_API_KEY RESEND_API_KEY AUTH_LINEAR_ID AUTH_LINEAR_SECRET AUTH_GITHUB_ID AUTH_GITHUB_SECRET AUTH_AIRTABLE_ID AUTH_AIRTABLE_SECRET AUTH_TODOIST_ID AUTH_TODOIST_SECRET AUTH_SLACK_ID AUTH_SLACK_SECRET AUTH_SLACK_SIGNING_SECRET AI_KEY_ENCRYPTION_KEY ADMIN_API_KEY UNIPILE_API_KEY UNIPILE_WEBHOOK_SECRET TOKEN_ENCRYPTION_KEY AUTH_TRELLO_ID AUTH_TRELLO_SECRET"
  },
  "scripts": {
    "get-env": "bash ../../scripts/get-env",
    "set-env": "bash ../../scripts/set-env",
    "dev": "wrangler dev --env development --test-scheduled",
    "deploy": "bash ../../scripts/deploy-worker",
    "deploy:vars": "bash ../../scripts/deploy-worker-vars",
    "types": "wrangler types",
    "db:types": "kysely-codegen --dialect postgres --url ${DATABASE_URL:-postgresql://postgres:postgres@localhost:54322/postgres} --out-file src/db-types.ts",
    "lint": "tsc && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.2",
    "@ai-sdk/google": "^4.0.6",
    "@ai-sdk/openai": "^4.0.5",
    "@clerk/backend": "^2.33.3",
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/puppeteer": "^1.0.4",
    "@hono-rate-limiter/cloudflare": "^0.2.2",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@plotday/classifier": "workspace:^",
    "@plotday/classifier-runtime": "workspace:^",
    "@plotday/db": "workspace:^",
    "@plotday/email": "workspace:^",
    "@plotday/pricing": "workspace:*",
    "@plotday/twister": "workspace:*",
    "@plotday/unipile": "workspace:^",
    "@plotday/worker-util": "workspace:^",
    "ai": "^7.0.11",
    "defuddle": "0.19.0",
    "hono": "^4.12.26",
    "hono-rate-limiter": "^0.5.3",
    "kysely": "^0.29.2",
    "linkedom": "0.18.12",
    "linkify-it": "^5.0.1",
    "p-limit": "^7.3.0",
    "pg": "^8.18.0",
    "posthog-node": "^5.38.1",
    "rrule": "^2.8.1",
    "stripe": "^17.5.0",
    "superjson": "^2.2.6",
    "typebox": "^1.0.35",
    "workers-ai-provider": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^4.20260617.1",
    "@plotday/eslint-config-custom": "workspace:*",
    "@plotday/tsconfig": "workspace:*",
    "@types/linkify-it": "^5.0.0",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.16.0",
    "kysely-codegen": "^0.20.0",
    "postgres-interval": "^4.0.2",
    "vitest": "^3.2.6"
  },
  "nx": {
    "tags": [
      "worker"
    ]
  }
}
