{
  "name": "@plotday/api",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "private": true,
  "config": {
    "deploy_vars": "SENTRY_DSN:SENTRY_WORKERS_DSN SUPABASE_URL SUPABASE_ANON_KEY SUPABASE_SERVICE_KEY AUTH_GOOGLE_ID AUTH_GOOGLE_SECRET AUTH_MICROSOFT_ID AUTH_MICROSOFT_SECRET API_ROOT AUTH_GOOGLE_ID AUTH_GOOGLE_SECRET AUTH_GOOGLE_IOS_ID AUTH_GOOGLE_ANDROID_ID AUTH_GOOGLE_DESKTOP_ID AUTH_GOOGLE_DESKTOP_SECRET STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET"
  },
  "scripts": {
    "env": "../../scripts/gen-env development $npm_package_config_deploy_vars > .dev.vars",
    "dev": "wrangler dev --env development --test-scheduled",
    "deploy": "../../scripts/deploy-worker",
    "deploy:vars": "../../scripts/deploy-worker-vars",
    "types": "wrangler types",
    "lint": "tsc && eslint ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.9",
    "@ai-sdk/google": "^1.0.13",
    "@ai-sdk/openai": "^1.0.14",
    "@plotday/db": "workspace:^",
    "@plotday/sdk": "workspace:*",
    "@sentry/cloudflare": "^10.12.0",
    "typebox": "^1.0.35",
    "@supabase/supabase-js": "^2.38.4",
    "ai": "^5.0.71",
    "hono": "^4.6.15",
    "stripe": "^17.5.0",
    "workers-ai-provider": "^2.0.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@plotday/eslint-config-custom": "workspace:*",
    "@plotday/tsconfig": "workspace:*",
    "@types/node": "^20.14.2"
  },
  "nx": {
    "tags": [
      "worker"
    ]
  }
}
