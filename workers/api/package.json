{
  "name": "@plotday/api",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "private": true,
  "config": {
    "deploy_vars": "SENTRY_DSN:SENTRY_WORKERS_DSN SUPABASE_URL SUPABASE_ANON_KEY SUPABASE_SERVICE_KEY GOOGLE_CLIENT_ID GOOGLE_OAUTH_SECRET MICROSOFT_CLIENT_ID MICROSOFT_OAUTH_SECRET CALENDAR_WEBHOOK_URL AUTH_CALLBACK_URL"
  },
  "scripts": {
    "env": "../../scripts/gen-env development $npm_package_config_deploy_vars > .dev.vars",
    "deploy": "../../scripts/deploy-worker",
    "deploy:vars": "../../scripts/deploy-worker-vars",
    "types": "wrangler types",
    "lint": "tsc && eslint ."
  },
  "dependencies": {
    "@plotday/agents": "workspace:^",
    "@plotday/cal": "workspace:^",
    "@plotday/db": "workspace:^",
    "@sentry/cloudflare": "^8.47.0",
    "@supabase/supabase-js": "^2.38.4",
    "hono": "^4.6.15",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@plotday/eslint-config-custom": "workspace:*",
    "@plotday/sync": "workspace:^",
    "@plotday/agent-runner": "workspace:^",
    "@plotday/tsconfig": "workspace:*",
    "@types/node": "^20.14.2"
  },
  "nx": {
    "tags": [
      "worker"
    ]
  }
}
