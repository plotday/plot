{
  "name": "@plotday/api",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "config": {
    "deploy_vars": "SENTRY_DSN:SENTRY_WORKERS_DSN SUPABASE_URL SUPABASE_ANON_KEY SUPABASE_SERVICE_KEY AUTH_GOOGLE_ID AUTH_GOOGLE_SECRET AUTH_MICROSOFT_ID AUTH_MICROSOFT_SECRET API_ROOT AUTH_GOOGLE_ID AUTH_GOOGLE_SECRET AUTH_GOOGLE_IOS_ID AUTH_GOOGLE_ANDROID_ID AUTH_GOOGLE_DESKTOP_ID AUTH_GOOGLE_DESKTOP_SECRET STRIPE_SECRET_KEY STRIPE_WEBHOOK_SECRET AI_GATEWAY_ACCOUNT_ID AI_GATEWAY_ID AI_GATEWAY_TOKEN ANTHROPIC_API_KEY"
  },
  "scripts": {
    "env": "../../scripts/gen-env development $npm_package_config_deploy_vars > .dev.vars",
    "dev": "wrangler dev --env development --test-scheduled",
    "deploy": "../../scripts/deploy-worker",
    "deploy:vars": "../../scripts/deploy-worker-vars",
    "types": "wrangler types",
    "lint": "tsc && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.33",
    "@ai-sdk/google": "^2.0.23",
    "@ai-sdk/openai": "^2.0.52",
    "@cloudflare/containers": "^0.0.28",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@plotday/db": "workspace:^",
    "@plotday/agent": "workspace:*",
    "@sentry/cloudflare": "^10.12.0",
    "@supabase/supabase-js": "^2.38.4",
    "ai": "^5.0.76",
    "hono": "^4.6.15",
    "stripe": "^17.5.0",
    "turndown": "^7.2.0",
    "typebox": "^1.0.35",
    "workers-ai-provider": "^2.0.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.7.8",
    "@cloudflare/workers-types": "^4.0.0",
    "@plotday/eslint-config-custom": "workspace:*",
    "@plotday/tsconfig": "workspace:*",
    "@types/node": "^20.14.2",
    "@types/turndown": "^5.0.6",
    "vitest": "^2.1.8"
  },
  "nx": {
    "tags": [
      "worker"
    ]
  }
}
