{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
  "upload_source_maps": true,
  "migrations": [
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "Storage",
        "Broadcast",
        "Usage",
        "Callbacks",
        "LogSubscriptions",
        "AgentBuilder"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["CallbacksState"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["TwistBuilder"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["LogStream"]
    },
    {
      "tag": "v9",
      "renamed_classes": [
        {
          "from": "Callbacks",
          "to": "CallbacksState"
        }
      ]
    },
    {
      "tag": "v10",
      "renamed_classes": [
        {
          "from": "AgentBuilder",
          "to": "TwistBuilder"
        }
      ]
    },
    {
      "tag": "v11",
      "new_sqlite_classes": ["SdkTokenStore"]
    },
    {
      "tag": "v12",
      "new_sqlite_classes": ["UserSync", "TwistSync"]
    },
    {
      "tag": "v13",
      "new_sqlite_classes": ["SyncRecovery"]
    },
    {
      "tag": "v14",
      "new_sqlite_classes": ["PrivacyReporting"]
    },
    {
      "tag": "v15",
      "new_sqlite_classes": ["SyncNotify"]
    },
    {
      "tag": "v16",
      "new_sqlite_classes": ["PushNotify"]
    },
    {
      "tag": "v17",
      "new_sqlite_classes": ["UserAiUsage"]
    }
  ],
  "env": {
    "development": {
      "define": {
        "ENV": "\"development\"",
        "RELEASE": "\"dev\"",
        "PACKAGE": "\"api\""
      },
      "vars": {
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:54322/postgres"
      },
      "kv_namespaces": [
        {
          "binding": "TWIST_CONFIG",
          "id": "c169930baecb4bd58c7edc727022a15e"
        },
        {
          "binding": "VOTES",
          "id": "2ed0dab96df24f8184ce353b4ad39d91"
        }
      ],
      "ratelimits": [
        {
          "name": "GENERAL_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 100, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "TOKEN_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "WEBHOOK_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "SYNC_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 200, "period": 60 }
        },
        {
          "name": "DEPLOYMENT_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "APP_SYNC_RATE_LIMITER",
          "namespace_id": "1007",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "worker_loaders": [
        {
          "binding": "LOADER"
        }
      ],
      "containers": [
        {
          "name": "agent_builder",
          "class_name": "TwistBuilder",
          "image": "./containers/twist-builder/Dockerfile",
          "instance_type": "basic",
          "max_instances": 1
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "run-development",
            "binding": "RUN_QUEUE"
          },
          {
            "queue": "updates-development",
            "binding": "UPDATES_QUEUE"
          },
          {
            "queue": "twist-logs-development",
            "binding": "TWIST_LOGS_QUEUE"
          },
          {
            "queue": "mail-development",
            "binding": "MAIL_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "run-development",
            "max_batch_size": 20,
            "max_batch_timeout": 5
          },
          {
            "queue": "updates-development",
            "max_batch_size": 50,
            "max_batch_timeout": 0
          },
          {
            "queue": "twist-logs-development",
            "max_batch_size": 100,
            "max_batch_timeout": 1
          },
          {
            "queue": "mail-development",
            "max_batch_size": 20,
            "max_batch_timeout": 3
          }
        ]
      },
      "ai": {
        "binding": "AI",
        "remote": true
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "STORAGE",
            "class_name": "Storage"
          },
          {
            "name": "CALLBACKS",
            "class_name": "CallbacksState"
          },
          {
            "name": "BROADCAST",
            "class_name": "Broadcast"
          },
          {
            "name": "USAGE",
            "class_name": "Usage"
          },
          {
            "name": "LOG_SUBSCRIPTIONS",
            "class_name": "LogSubscriptions"
          },
          {
            "name": "LOG_STREAM",
            "class_name": "LogStream"
          },
          {
            "name": "TWIST_BUILDER",
            "class_name": "TwistBuilder"
          },
          {
            "name": "SDK_TOKEN_STORE",
            "class_name": "SdkTokenStore"
          },
          {
            "name": "USER_SYNC",
            "class_name": "UserSync"
          },
          {
            "name": "TWIST_SYNC",
            "class_name": "TwistSync"
          },
          {
            "name": "SYNC_NOTIFY",
            "class_name": "SyncNotify"
          },
          {
            "name": "SYNC_RECOVERY",
            "class_name": "SyncRecovery"
          },
          {
            "name": "PRIVACY_REPORTING",
            "class_name": "PrivacyReporting"
          },
          {
            "name": "PUSH_NOTIFY",
            "class_name": "PushNotify"
          },
          {
            "name": "USER_AI_USAGE",
            "class_name": "UserAiUsage"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "TWIST_MODULES_BUCKET",
          "bucket_name": "twist-modules-development"
        },
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "plot-files-development"
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    },
    "production": {
      "routes": [
        {
          "pattern": "api.plot.day",
          "custom_domain": true
        }
      ],
      "define": {
        "ENV": "\"production\"",
        "RELEASE": "\"prod\"",
        "PACKAGE": "\"api\""
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "831ea7d10ef54346b084baaa1a46dfa6",
          "localConnectionString": "postgresql://postgres:postgres@localhost:54322/postgres"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "TWIST_CONFIG",
          "id": "c413b23bb866493da4ee0596ade8b1e2"
        },
        {
          "binding": "VOTES",
          "id": "2ed0dab96df24f8184ce353b4ad39d91"
        }
      ],
      "ratelimits": [
        {
          "name": "GENERAL_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 100, "period": 60 }
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "TOKEN_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "WEBHOOK_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 300, "period": 60 }
        },
        {
          "name": "SYNC_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 200, "period": 60 }
        },
        {
          "name": "DEPLOYMENT_RATE_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "APP_SYNC_RATE_LIMITER",
          "namespace_id": "1007",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "worker_loaders": [
        {
          "binding": "LOADER"
        }
      ],
      "containers": [
        {
          "name": "agent_builder",
          "class_name": "TwistBuilder",
          "image": "./containers/twist-builder/Dockerfile",
          "max_instances": 3
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "run-production",
            "binding": "RUN_QUEUE"
          },
          {
            "queue": "updates-production-v2",
            "binding": "UPDATES_QUEUE"
          },
          {
            "queue": "twist-logs-production",
            "binding": "TWIST_LOGS_QUEUE"
          },
          {
            "queue": "mail-production",
            "binding": "MAIL_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "run-production",
            "max_batch_size": 100,
            "max_batch_timeout": 30
          },
          {
            "queue": "updates-production-v2",
            "max_batch_size": 50,
            "max_batch_timeout": 0
          },
          {
            "queue": "twist-logs-production",
            "max_batch_size": 100,
            "max_batch_timeout": 1
          }
        ]
      },
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "STORAGE",
            "class_name": "Storage"
          },
          {
            "name": "CALLBACKS",
            "class_name": "CallbacksState"
          },
          {
            "name": "BROADCAST",
            "class_name": "Broadcast"
          },
          {
            "name": "USAGE",
            "class_name": "Usage"
          },
          {
            "name": "LOG_SUBSCRIPTIONS",
            "class_name": "LogSubscriptions"
          },
          {
            "name": "LOG_STREAM",
            "class_name": "LogStream"
          },
          {
            "name": "TWIST_BUILDER",
            "class_name": "TwistBuilder"
          },
          {
            "name": "SDK_TOKEN_STORE",
            "class_name": "SdkTokenStore"
          },
          {
            "name": "USER_SYNC",
            "class_name": "UserSync"
          },
          {
            "name": "TWIST_SYNC",
            "class_name": "TwistSync"
          },
          {
            "name": "SYNC_NOTIFY",
            "class_name": "SyncNotify"
          },
          {
            "name": "SYNC_RECOVERY",
            "class_name": "SyncRecovery"
          },
          {
            "name": "PRIVACY_REPORTING",
            "class_name": "PrivacyReporting"
          },
          {
            "name": "PUSH_NOTIFY",
            "class_name": "PushNotify"
          },
          {
            "name": "USER_AI_USAGE",
            "class_name": "UserAiUsage"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "TWIST_MODULES_BUCKET",
          "bucket_name": "twist-modules-production"
        },
        {
          "binding": "FILES_BUCKET",
          "bucket_name": "plot-files-production"
        }
      ],
      "triggers": {
        "crons": ["*/5 * * * *"]
      }
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "destinations": ["posthog-logs"]
    },
    "traces": {
      "enabled": true,
      "destinations": ["posthog-logs"],
      "head_sampling_rate": 0.1
    }
  }
}
