{
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
  "upload_source_maps": true,
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Storage",
        "Callbacks",
        "Broadcast",
        "Usage",
        "LogSubscriptions"
      ]
    }
  ],
  "env": {
    "development": {
      "define": {
        "ENV": "\"development\"",
        "RELEASE": "\"dev\"",
        "PACKAGE": "\"api\""
      },
      "worker_loaders": [
        {
          "binding": "LOADER"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "run-development",
            "binding": "RUN_QUEUE"
          },
          {
            "queue": "updates-development",
            "binding": "UPDATES_QUEUE"
          },
          {
            "queue": "agent-logs-development",
            "binding": "AGENT_LOGS_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "run-development",
            "max_batch_size": 20,
            "max_batch_timeout": 5
          },
          {
            "queue": "updates-development",
            "max_batch_size": 50,
            "max_batch_timeout": 0
          },
          {
            "queue": "agent-logs-development",
            "max_batch_size": 100,
            "max_batch_timeout": 1
          }
        ]
      },
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "STORAGE",
            "class_name": "Storage"
          },
          {
            "name": "CALLBACKS",
            "class_name": "Callbacks"
          },
          {
            "name": "BROADCAST",
            "class_name": "Broadcast"
          },
          {
            "name": "USAGE",
            "class_name": "Usage"
          },
          {
            "name": "LOG_SUBSCRIPTIONS",
            "class_name": "LogSubscriptions"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "AGENT_MODULES_BUCKET",
          "bucket_name": "agent-modules-development"
        }
      ]
    },
    "production": {
      "routes": [
        {
          "pattern": "api.plot.day",
          "custom_domain": true
        }
      ],
      "define": {
        "ENV": "\"production\"",
        "RELEASE": "\"prod\"",
        "PACKAGE": "\"api\""
      },
      "worker_loaders": [
        {
          "binding": "LOADER"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "run-production",
            "binding": "RUN_QUEUE"
          },
          {
            "queue": "updates-production",
            "binding": "UPDATES_QUEUE"
          },
          {
            "queue": "agent-logs-production",
            "binding": "AGENT_LOGS_QUEUE"
          }
        ],
        "consumers": [
          {
            "queue": "run-production",
            "max_batch_size": 100,
            "max_batch_timeout": 30
          },
          {
            "queue": "updates-production",
            "max_batch_size": 50,
            "max_batch_timeout": 0
          },
          {
            "queue": "agent-logs-production",
            "max_batch_size": 100,
            "max_batch_timeout": 1
          }
        ]
      },
      "ai": {
        "binding": "AI"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "STORAGE",
            "class_name": "Storage"
          },
          {
            "name": "CALLBACKS",
            "class_name": "Callbacks"
          },
          {
            "name": "BROADCAST",
            "class_name": "Broadcast"
          },
          {
            "name": "USAGE",
            "class_name": "Usage"
          },
          {
            "name": "LOG_SUBSCRIPTIONS",
            "class_name": "LogSubscriptions"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "AGENT_MODULES_BUCKET",
          "bucket_name": "agent-modules-production"
        }
      ]
    }
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
