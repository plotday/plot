{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "classify",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "env": {
    "development": {
      "define": {
        "ENV": "\"development\"",
        "RELEASE": "\"dev\"",
        "PACKAGE": "\"classify\""
      },
      "vars": {},
      "kv_namespaces": [
        {
          "binding": "LLM_CACHE",
          "id": "c169930baecb4bd58c7edc727022a15e"
        }
      ],
      "queues": {
        "consumers": [
          {
            "queue": "classify-thread-development",
            // Larger batches let the per-(user, batch) classifier cache amortize
            // across more of one user's swept threads: the hourly sweep enqueues
            // a user's pending rows contiguously, so a bigger batch means each
            // user-scoped read (training set, focuses, ...) runs once for ~25
            // threads instead of ~10 — and fewer, fuller invocations means less
            // churn against the Hyperdrive pool. Cloudflare caps this at 100.
            "max_batch_size": 25,
            "max_batch_timeout": 10,
            "max_retries": 4,
            // Bound concurrent consumer invocations. Without this, Cloudflare
            // autoscales concurrency to drain a backlog fast — so an hourly
            // sweep enqueueing up to 1000 jobs spins up many invocations at
            // once, each holding a connection, and saturates the shared 60-slot
            // Hyperdrive pool. That contention is what pushed otherwise-cheap
            // classify queries (~60ms) past the 30s statement_timeout (PostHog
            // 019ed53e) and exhausted the pool (019ed3b3). 4 keeps classify a
            // small slice of the pool; raise it only with pool headroom.
            "max_concurrency": 4
          }
        ]
      }
    },
    "production": {
      "define": {
        "ENV": "\"production\"",
        "RELEASE": "\"prod\"",
        "PACKAGE": "\"classify\""
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "831ea7d10ef54346b084baaa1a46dfa6",
          "localConnectionString": "postgresql://postgres:postgres@localhost:54322/postgres"
        },
        {
          "binding": "HYPERDRIVE_BG",
          "id": "REPLACE_WITH_HYPERDRIVE_BG_ID",
          "localConnectionString": "postgresql://postgres:postgres@localhost:54322/postgres"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "LLM_CACHE",
          "id": "c413b23bb866493da4ee0596ade8b1e2"
        }
      ],
      "queues": {
        "consumers": [
          {
            "queue": "classify-thread-production",
            // Larger batches let the per-(user, batch) classifier cache amortize
            // across more of one user's swept threads: the hourly sweep enqueues
            // a user's pending rows contiguously, so a bigger batch means each
            // user-scoped read (training set, focuses, ...) runs once for ~25
            // threads instead of ~10 — and fewer, fuller invocations means less
            // churn against the Hyperdrive pool. Cloudflare caps this at 100.
            "max_batch_size": 25,
            "max_batch_timeout": 10,
            "max_retries": 4,
            // Bound concurrent consumer invocations. Without this, Cloudflare
            // autoscales concurrency to drain a backlog fast — so an hourly
            // sweep enqueueing up to 1000 jobs spins up many invocations at
            // once, each holding a connection, and saturates the shared 60-slot
            // Hyperdrive pool. That contention is what pushed otherwise-cheap
            // classify queries (~60ms) past the 30s statement_timeout (PostHog
            // 019ed53e) and exhausted the pool (019ed3b3). 4 keeps classify a
            // small slice of the pool; raise it only with pool headroom.
            "max_concurrency": 4
          }
        ]
      }
    }
  },
  "placement": {
    "mode": "smart"
  },
  "dev": {
    "port": 8786
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "destinations": ["posthog-logs"]
    }
  }
}
