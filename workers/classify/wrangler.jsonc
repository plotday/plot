{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "classify",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "env": {
    "development": {
      "define": {
        "ENV": "\"development\"",
        "RELEASE": "\"dev\"",
        "PACKAGE": "\"classify\""
      },
      "vars": {},
      "kv_namespaces": [
        {
          "binding": "LLM_CACHE",
          "id": "c169930baecb4bd58c7edc727022a15e"
        }
      ],
      "queues": {
        "consumers": [
          {
            "queue": "classify-thread-development",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 4
          }
        ]
      }
    },
    "production": {
      "define": {
        "ENV": "\"production\"",
        "RELEASE": "\"prod\"",
        "PACKAGE": "\"classify\""
      },
      "queues": {
        "consumers": [
          {
            "queue": "classify-thread-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 4
          }
        ]
      }
    }
  },
  "placement": {
    "mode": "smart"
  },
  "dev": {
    "port": 8786
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "destinations": ["posthog-logs"]
    }
  }
}
