{
  "name": "@plotday/calendar-webhook",
  "version": "0.0.2",
  "sideEffects": false,
  "private": true,
  "deploy_vars": "SENTRY_DSN:SENTRY_WORKERS_DSN SUPABASE_URL GOOGLE_CLIENT_ID MICROSOFT_CLIENT_ID",
  "scripts": {
    "dev": "pnpm run dev:config && pnpm run dev:start",
    "dev:config": "../../scripts/gen-env development $npm_package_env_vars > .dev.vars",
    "dev:start": "wrangler dev --inspector-port 9231",
    "deploy": "../../scripts/deploy-worker",
    "deploy-vars": "../../scripts/deploy-worker-vars",
    "lint": "tsc && eslint ."
  },
  "dependencies": {
    "@plotday/cal": "workspace:^",
    "@plotday/db": "workspace:^",
    "@supabase/supabase-js": "^2.38.4",
    "toucan-js": "^3.3.0"
  },
  "devDependencies": {
    "@plotday/eslint-config-custom": "workspace:*",
    "@plotday/sync": "workspace:^",
    "@plotday/tsconfig": "workspace:*"
  },
  "nx": {
    "tags": [
      "worker"
    ]
  }
}
