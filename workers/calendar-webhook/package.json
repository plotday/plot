{
  "name": "@plotday/calendar-webhook",
  "version": "0.0.2",
  "sideEffects": false,
  "private": true,
  "env_vars": "SUPABASE_URL SUPABASE_SERVICE_KEY SENTRY_DSN SENTRY_AUTH_TOKEN SENTRY_ORG SENTRY_PROJECT CLOUDFLARE_API_TOKEN GOOGLE_CLIENT_ID GOOGLE_OAUTH_SECRET MICROSOFT_CLIENT_ID MICROSOFT_OAUTH_SECRET",
  "deploy_vars": "SENTRY_DSN SUPABASE_URL GOOGLE_CLIENT_ID MICROSOFT_CLIENT_ID",
  "scripts": {
    "dev": "pnpm run dev:config && pnpm run dev:start",
    "dev:config": "../../scripts/gen-env $npm_package_env_vars > .dev.vars",
    "dev:start": "wrangler dev --env development",
    "deploy": "../../scripts/deploy-worker",
    "lint": "tsc && eslint ."
  },
  "dependencies": {
    "@plotday/cal": "workspace:^",
    "@plotday/db": "workspace:^",
    "@plotday/worker-request": "workspace:^",
    "@supabase/supabase-js": "^2.36.0",
    "toucan-js": "^3.3.0"
  },
  "devDependencies": {
    "@plotday/eslint-config-custom": "workspace:*",
    "@plotday/tsconfig": "workspace:*"
  }
}
