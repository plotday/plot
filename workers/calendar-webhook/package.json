{
  "name": "@plotday/calendar-webhook",
  "version": "0.0.2",
  "sideEffects": false,
  "private": true,
  "config": {
    "deploy_vars": "SENTRY_DSN:SENTRY_WORKERS_DSN SUPABASE_URL SUPABASE_SERVICE_KEY GOOGLE_CLIENT_ID GOOGLE_OAUTH_SECRET MICROSOFT_CLIENT_ID MICROSOFT_OAUTH_SECRET"
  },
  "scripts": {
    "env": "../../scripts/gen-env development $npm_package_config_deploy_vars > .dev.vars",
    "deploy": "../../scripts/deploy-worker",
