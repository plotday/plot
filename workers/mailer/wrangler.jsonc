{
  "name": "mail",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "env": {
    "development": {
      "define": {
        "ENV": "\"development\"",
        "RELEASE": "\"dev\"",
        "PACKAGE": "\"mailer\""
      },
      "queues": {
        "consumers": [
          {
            "queue": "mail-development",
            "max_batch_size": 20,
            "max_batch_timeout": 3
            // No max_retries - worker controls retry logic via message.retry({ delaySeconds })
          }
        ]
      },
      "vars": {
        "SUPABASE_URL": "http://127.0.0.1:54321",
        "SUPABASE_SERVICE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"
      }
    },
    "production": {
      "define": {
        "ENV": "\"production\"",
        "RELEASE": "\"prod\"",
        "PACKAGE": "\"mailer\""
      },
      "queues": {
        "consumers": [
          {
            "queue": "mail-production",
            "max_batch_size": 20,
            "max_batch_timeout": 3
            // No max_retries - worker controls retry logic via message.retry({ delaySeconds })
          }
        ]
      }
      // Note: SUPABASE_URL and SUPABASE_SERVICE_KEY are set via wrangler secrets in production
    }
  },
  "placement": {
    "mode": "smart"
  },
  "dev": {
    "port": 8784
  },
  "observability": {
    "logs": {
      "enabled": true,
      "destinations": ["posthog-logs"]
    }
  }
}
