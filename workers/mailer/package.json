{
  "name": "@plotday/mailer",
  "version": "0.0.2",
  "sideEffects": false,
  "private": true,
  "config": {
    "deploy_vars": "POSTHOG_API_KEY POSTHOG_HOST RESEND_API_KEY"
  },
  "scripts": {
