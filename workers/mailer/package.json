{
  "name": "@plotday/mailer",
  "version": "0.0.2",
  "sideEffects": false,
  "private": true,
  "config": {
    "deploy_vars": "POSTHOG_API_KEY POSTHOG_HOST RESEND_API_KEY"
  },
  "scripts": {
    "env": "../../scripts/gen-env development $npm_package_config_deploy_vars > .dev.vars",
    "deploy": "../../scripts/deploy-worker",
    "deploy:vars": "../../scripts/deploy-worker-vars",
    "types": "wrangler types",
    "lint": "tsc && eslint ."
  },
  "dependencies": {
    "@plotday/email": "workspace:^",
    "posthog-node": "^5.11.0"
