{
  "name": "@plotday/agent-runner",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "version": "0.0.1",
  "private": true,
  "config": {
    "deploy_vars": "SENTRY_DSN:SENTRY_WORKERS_DSN"
  },
  "scripts": {
    "env": "../../scripts/gen-env development $npm_package_config_deploy_vars > .dev.vars",
    "deploy": "../../scripts/deploy-worker",
    "deploy:vars": "../../scripts/deploy-worker-vars",
    "types": "wrangler types",
    "lint": "tsc && eslint ."
  },
  "dependencies": {
    "@plotday/agents": "workspace:^",
    "@plotday/db": "workspace:^",
    "@worker-tools/json-fetch": "2.1.0-pre.6"
  },
  "devDependencies": {
    "@plotday/eslint-config-custom": "workspace:*",
    "@plotday/tsconfig": "workspace:*",
    "@types/node": "^22.15.19"
  },
  "nx": {
    "tags": [
      "worker"
    ]
  }
}
