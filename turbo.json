{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    ".env.*",
    ".env.*.*",
    ".github/workflows/*",
    "scripts/*",
    "lib/tsconfig/*.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "SENTRY_DSN",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_OAUTH_SECRET",
    "MICROSOFT_CLIENT_ID",
    "MICROSOFT_OAUTH_SECRET"
  ],
  "pipeline": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build", "topo"],
      "outputs": ["build/**"]
    },
    "deploy": {
      "dependsOn": ["^build", "build"]
    },
    "deploy:workers:changed": {
      "dependsOn": ["^build", "build"]
    },
    "lint": {},
    "test": {},
    "@plotday/db#test": {
      "dependsOn": ["@plotday/db#start"]
    },
    "@plotday/cal#test": {
      "env": [
        "TEST_GOOGLE_ACCOUNT_ACCESS_TOKEN",
        "TEST_GOOGLE_ACCOUNT_REFRESH_TOKEN",
        "TEST_OUTLOOK_ACCOUNT_ACCESS_TOKEN",
        "TEST_OUTLOOK_ACCOUNT_REFRESH_TOKEN"
      ]
    },
    "test:watch": {
      "dependsOn": ["@plotday/db#start"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@plotday/db#start"]
    },
    "start": {
      "cache": false
    },
    "stop": {
      "cache": false
    },
    "@plotday/db#start": {
      "persistent": false
    },
    "@plotday/db#gen-types": {
      "dependsOn": ["@plotday/db#start"],
      "cache": false
    },
    "@plotday/db#gen-migration": {
      "dependsOn": ["@plotday/db#start"]
    },
    "@plotday/web#build": {
      "outputs": [
        "build/**",
        "public/build/**",
        "functions/\\[path\\].js",
        "functions/\\[path\\].js.map"
      ]
    },
    "pre-commit": {}
  }
}
