{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.*", ".env.*.*", "lib/tsconfig/*.json"],
  "globalEnv": [
    "NODE_ENV",
    "SENTRY_DSN",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_OAUTH_SECRET",
    "MICROSOFT_CLIENT_ID",
    "MICROSOFT_OAUTH_SECRET",
    "AMPLITUDE_API_KEY",
    "AIRPLANE_ENV_SLUG"
  ],
  "pipeline": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build", "topo"],
      "outputs": ["build/**"],
      "inputs": ["$TURBO_DEFAULT$", "scripts/*"]
    },
    "deploy": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "scripts/*"]
    },
    "deploy:workers:changed": {
      "dependsOn": ["^build", "build"]
    },
    "lint": {},
    "test": {},
    "@plotday/db#test": {
      "dependsOn": ["@plotday/db#start"]
    },
    "@plotday/cal#test": {
      "env": [
        "TEST_GOOGLE_ACCOUNT_ACCESS_TOKEN",
        "TEST_GOOGLE_ACCOUNT_REFRESH_TOKEN",
        "TEST_OUTLOOK_ACCOUNT_ACCESS_TOKEN",
        "TEST_OUTLOOK_ACCOUNT_REFRESH_TOKEN"
      ]
    },
    "test:watch": {
      "dependsOn": ["@plotday/db#start"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@plotday/db#start"]
    },
    "start": {
      "cache": false
    },
    "stop": {
      "cache": false
    },
    "@plotday/db#start": {
      "persistent": false
    },
    "@plotday/db#gen-types": {
      "dependsOn": ["@plotday/db#start"],
      "cache": false
    },
    "@plotday/db#gen-migration": {
      "dependsOn": ["@plotday/db#start"]
    },
    "@plotday/web#build": {
      "outputs": [
        "build/**",
        "public/build/**",
        "functions/\\[path\\].js",
        "functions/\\[path\\].js.map"
      ]
    },
    "@plotday/calendar#build:web": {
      "outputs": ["build/web/**"],
      "inputs": ["$turbo_default$", "scripts/*"]
    },
    "pre-commit": {},
    "@plotday/dev#pre-commit": {
      "inputs": ["**/package.json", "**/pnpm-lock.json"]
    },
    "migrate": {},
    "@plotday/db#migrate": {
      "inputs": ["lib/db/supabase/migrations/*"]
    }
  }
}
