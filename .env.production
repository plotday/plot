# Supabase API Keys (new format)
# SUPABASE_ANON_KEY: Publishable key for client-side use (sb_publishable_*)
# SUPABASE_SERVICE_KEY: Secret key for server-side use (sb_secret_*)
SUPABASE_URL=op://Production/Supabase/API/url
SUPABASE_ANON_KEY=op://Production/Supabase/API/public key
SUPABASE_SERVICE_KEY=op://Production/Supabase/API/secret key

AUTH_CALLBACK_URL=https://app.plot.day/auth/callback
API_ROOT=https://api.plot.day
APP_ROOT=https://app.plot.day
SITE_ROOT=https://plot.day
