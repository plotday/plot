# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:ios)

platform :ios do
  desc "Build the iOS app"
  lane :build do
    # Install CocoaPods dependencies
    cocoapods(
      clean_install: true,
      podfile: "./Podfile"
    )

    # Build the Flutter iOS app. APP_STORE_BUILD=true ensures the upgrade /
    # billing UI and Stripe checkout flow are stripped from the binary
    # (guideline 3.1.1). The iOS Flutter target only ships through the App
    # Store, so the flag is unconditional.
    sh("cd ../.. && flutter build ios --release --no-codesign --dart-define=APP_STORE_BUILD=true")

    UI.success("iOS build completed successfully!")
  end

  desc "Print the highest already-approved App Store marketing version across iOS + macOS"
  lane :latest_approved_version do
    require "spaceship"

    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV["ASC_API_KEY_ID"],
      issuer_id: ENV["ASC_API_ISSUER_ID"],
      filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['ASC_API_KEY_ID']}.p8"),
    )
    Spaceship::ConnectAPI.token = token

    app = Spaceship::ConnectAPI::App.find("day.plot.app")
    if app.nil?
      UI.user_error!("Could not find app day.plot.app in App Store Connect")
    end

    versions = []
    [
      Spaceship::ConnectAPI::Platform::IOS,
      Spaceship::ConnectAPI::Platform::MAC_OS,
    ].each do |platform|
      # The live (READY_FOR_SALE) version is exactly what Apple compares a new
      # upload against for error 90062. nil before the first-ever release.
      live = app.get_live_app_store_version(platform: platform)
      versions << live.version_string if live && live.version_string
    end

    latest = versions.max_by { |s| Gem::Version.new(s) }
    # Stable, greppable marker for the workflow to parse.
    UI.message("LATEST_APPROVED_VERSION=#{latest}")
    latest
  end

  desc "Build and archive the iOS app"
  lane :archive do
    # Ensure we have the latest provisioning profiles
    # Note: Using automatic signing for now, can switch to match later

    # Install CocoaPods dependencies
    cocoapods(
      clean_install: true,
      podfile: "./Podfile"
    )

    # Build the Flutter iOS app with archive. APP_STORE_BUILD=true strips
    # web upgrade flows (guideline 3.1.1) — see :build lane comment.
    sh("cd ../.. && flutter build ipa --release --dart-define=APP_STORE_BUILD=true")

    UI.success("iOS archive completed successfully!")
  end

  desc "Generate screenshots for App Store"
  lane :screenshots do
    snapshot
    UI.success("Screenshots generated successfully!")
  end

  desc "Upload a new beta build to TestFlight"
  lane :beta do
    # Build and archive
    archive

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )

    UI.success("Beta build uploaded to TestFlight!")
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :metadata do
    options = {
      skip_binary_upload: true,
      # Honor the release workflow's update_metadata / update_screenshots flags.
      # SKIP_* default to unset => false => upload, preserving local behavior.
      skip_metadata: ENV["SKIP_METADATA"] == "true",
      skip_screenshots: ENV["SKIP_SCREENSHOTS"] == "true",
      # The committed store assets are the source of truth. Use deliver's sync
      # logic (checksum-diff: upload only the missing shots, delete only the
      # extras) rather than overwrite_screenshots. overwrite uploads the whole
      # set, then reads it back to verify; App Store Connect processes
      # screenshots asynchronously, so the readback fires before processing
      # finishes, reports every shot "missing on App Store Connect," and
      # blind-retries the entire set — leaving two copies of each screenshot on
      # the listing. sync_screenshots converges idempotently and is retry-safe.
      # (deliver >= 2.191; the runner ships 2.236, where it needs no env flag.)
      sync_screenshots: true,
      # We never submit for review here, so skip the metadata precheck.
      run_precheck_before_submit: false,
      force: true,
    }

    # In CI, authenticate with the App Store Connect API key (ASC_API_* secrets
    # plus the .p8 decoded into ~/.appstoreconnect/private_keys). Locally, fall
    # back to the Appfile's apple_id session auth.
    if ENV["ASC_API_KEY_ID"] && ENV["ASC_API_ISSUER_ID"]
      options[:api_key] = app_store_connect_api_key(
        key_id: ENV["ASC_API_KEY_ID"],
        issuer_id: ENV["ASC_API_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['ASC_API_KEY_ID']}.p8")
      )
    end

    upload_to_app_store(options)

    UI.success("Metadata uploaded to App Store Connect!")
  end

  desc "Deploy a new version to the App Store"
  lane :release do
    # Build and archive
    archive

    # Upload to App Store
    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )

    UI.success("Release uploaded to App Store Connect!")
  end

  desc "Submit an already-uploaded build to App Store review (no binary upload)"
  lane :submit do
    options = {
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      # User retains the go-live click after approval (see plan Global Constraints).
      automatic_release: false,
      force: true,
      # The inline path submits seconds after altool upload. deliver waits for
      # App Store Connect to finish processing the build automatically when
      # submit_for_review is set (BuildWatcher.wait_for_build_processing_to_be_complete),
      # so no explicit wait option is needed. The old wait_for_uploaded_build
      # option was removed from deliver and now hard-errors if passed.
      precheck_include_in_app_purchases: false,
      # Plot does not use the advertising identifier; answer the IDFA question
      # non-interactively so deliver never blocks in CI.
      submission_information: { add_id_info_uses_idfa: false },
    }

    # Target a specific build when asked (standalone submit workflow), else
    # deliver picks the latest processed build for the current version.
    options[:build_number] = ENV["SUBMIT_BUILD_NUMBER"] if ENV["SUBMIT_BUILD_NUMBER"] && !ENV["SUBMIT_BUILD_NUMBER"].empty?
    # Target the right "Prepare for Submission" marketing version (deliver
    # creates it if needed) rather than letting deliver guess.
    options[:app_version] = ENV["SUBMIT_APP_VERSION"] if ENV["SUBMIT_APP_VERSION"] && !ENV["SUBMIT_APP_VERSION"].empty?

    if ENV["ASC_API_KEY_ID"] && ENV["ASC_API_ISSUER_ID"]
      options[:api_key] = app_store_connect_api_key(
        key_id: ENV["ASC_API_KEY_ID"],
        issuer_id: ENV["ASC_API_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['ASC_API_KEY_ID']}.p8")
      )
    end

    upload_to_app_store(options)

    UI.success("iOS build submitted for App Store review!")
  end

  desc "Run tests"
  lane :test do
    sh("cd ../.. && flutter test")
    UI.success("Tests completed successfully!")
  end

  # Error handling
  error do |lane, exception|
    UI.error("Error in lane '#{lane}': #{exception}")
  end
end
