import 'store.dart';

CREATE VIEW IF NOT EXISTS priority_ancestry AS
WITH RECURSIVE ancestors (
    priority_id,
    path,
    ancestor_path,
    depth
) AS (
    -- Base case: Get the first-level ancestor path for each priority
    SELECT
        id AS priority_id,
        path,
        substr(path, 1, instr (path, '.') - 1) AS ancestor_path,
        1 AS depth
    FROM
        priorities
    WHERE
        instr (path, '.') > 0
    UNION ALL
    -- Recursive case: Get the next level ancestor path using a different approach
    SELECT
        priority_id,
        path,
        substr(path, 1, length(ancestor_path) + instr (substr(path, length(ancestor_path) + 2), '.')) ancestor_path,
        depth + 1
    FROM
        ancestors
    WHERE
        -- Continue only if there's another dot after the current ancestor_path
        instr (substr(path, length(ancestor_path) + 2), '.') > 0
)
SELECT
    priority_id,
    json_group_array (a.title) AS titles,
    json_group_array (lower(substr(hex (a.id), 1, 8) || '-' || substr(hex (a.id), 9, 4) || '-' || substr(hex (a.id), 13, 4) || '-' || substr(hex (a.id), 17, 4) || '-' || substr(hex (a.id), 21, 12))) AS ancestors,
    json_group_array (a.color) AS colors,
    MIN(a.top_order) AS min_ancestor_top_order,
    MAX(CASE WHEN a.archived_at IS NOT NULL THEN 1 ELSE 0 END) AS has_archived_ancestor
FROM
    ancestors an
    LEFT JOIN priorities a ON a.path = an.ancestor_path
GROUP BY
    priority_id
ORDER BY
    priority_id;

CREATE VIEW IF NOT EXISTS latest_priorities AS
SELECT
    priority_id,
    MAX("end") AS at
FROM
    sessions
GROUP BY
    priority_id;

