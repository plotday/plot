import 'store.dart';

-- Trigger rebuild
CREATE VIEW activity_next_event AS
WITH ranked_events AS (
    SELECT
        e.id AS event_id,
        e.series,
        e.start AS start,
        ROW_NUMBER() OVER (PARTITION BY e.series ORDER BY e.start ASC) AS rn
    FROM
        events e
    WHERE
        e.series IS NOT NULL
        AND e.end < datetime ('now'))
SELECT
    a.id AS activity_id,
    re.event_id,
    re.start
FROM
    activities a
    INNER JOIN ranked_events re ON a.event_series = re.series
        AND re.rn = 1
WHERE
    a.event_series IS NOT NULL;

