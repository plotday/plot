# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:android)

platform :android do
  desc "Build the Android app (App Bundle)"
  lane :build do
    # Build the Flutter Android app as an App Bundle
    sh("cd ../.. && flutter build appbundle --release")

    UI.success("Android App Bundle build completed successfully!")
  end

  desc "Build APK"
  lane :build_apk do
    # Build the Flutter Android app as an APK
    sh("cd ../.. && flutter build apk --release")

    UI.success("Android APK build completed successfully!")
  end

  desc "Generate screenshots for Play Store"
  lane :screenshots do
    # Ensure the app is built
    build_apk

    # Generate screenshots using Screengrab
    screengrab(
      clear_previous_screenshots: true,
      app_apk_path: "../build/app/outputs/flutter-apk/app-release.apk"
    )

    UI.success("Screenshots generated successfully!")
  end

  desc "Upload a new beta version to the Google Play (Internal Testing)"
  lane :beta do
    # Upload pre-built AAB to Google Play Internal Testing track
    # (build is done externally by Shorebird or Flutter)
    upload_to_play_store(
      track: 'internal',
      aab: '../../build/app/outputs/bundle/release/app-release.aab',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'draft'
    )

    UI.success("Beta version uploaded to Google Play Internal Testing!")
  end

  desc "Upload metadata to Google Play Console"
  lane :metadata do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )

    UI.success("Metadata uploaded to Google Play Console!")
  end

  desc "Promote beta to production"
  lane :promote_to_production do
    upload_to_play_store(
      track: 'internal',
      track_promote_to: 'production',
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success("Beta promoted to production!")
  end

  desc "Deploy a new version to the Google Play (Production)"
  lane :release do
    # Build the app bundle
    build

    # Upload to Google Play Production track
    upload_to_play_store(
      track: 'production',
      aab: '../../build/app/outputs/bundle/release/app-release.aab',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'draft'
    )

    UI.success("Release uploaded to Google Play Production (as draft)!")
  end

  desc "Run tests"
  lane :test do
    sh("cd ../.. && flutter test")
    UI.success("Tests completed successfully!")
  end

  # Error handling
  error do |lane, exception|
    UI.error("Error in lane '#{lane}': #{exception}")
  end
end
