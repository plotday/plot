# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:android)

platform :android do
  desc "Build the Android app (App Bundle)"
  lane :build do
    # Build the Flutter Android app as an App Bundle
    sh("cd ../.. && flutter build appbundle --release")

    UI.success("Android App Bundle build completed successfully!")
  end

  desc "Build APK"
  lane :build_apk do
    # Build the Flutter Android app as an APK
    sh("cd ../.. && flutter build apk --release")

    UI.success("Android APK build completed successfully!")
  end

  desc "Generate screenshots for Play Store"
  lane :screenshots do
    # Ensure the app is built
    build_apk

    # Generate screenshots using Screengrab
    screengrab(
      clear_previous_screenshots: true,
      app_apk_path: "../build/app/outputs/flutter-apk/app-release.apk"
    )

    UI.success("Screenshots generated successfully!")
  end

  desc "Upload a new beta version to the Google Play (Internal Testing)"
  lane :beta do |options|
    # Upload pre-built AAB to Google Play Internal Testing track
    # (build is done externally by Shorebird or Flutter)
    aab_path = options[:aab] || '../../build/app/outputs/bundle/release/app-release.aab'
    upload_to_play_store(
      track: 'internal',
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'draft'
    )

    UI.success("Beta version uploaded to Google Play Internal Testing!")
  end

  desc "Upload metadata and screenshots to Google Play Console"
  lane :metadata do
    # Push the store listing (title, descriptions, feature graphic) and the
    # staged screenshots. Auth is via the Appfile's json_key_file
    # (play-deployer-service-key.json). Release notes are not managed here, so
    # skip changelogs — there is no metadata/android/en-US/changelogs dir and we
    # never want a release gated on one.
    # Honor the release workflow's update_metadata / update_screenshots flags.
    # SKIP_* default to unset => false => upload, preserving local behavior.
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: ENV["SKIP_METADATA"] == "true",
      skip_upload_images: ENV["SKIP_SCREENSHOTS"] == "true",
      skip_upload_screenshots: ENV["SKIP_SCREENSHOTS"] == "true",
      skip_upload_changelogs: true
    )

    UI.success("Metadata uploaded to Google Play Console!")
  end

  desc "Promote the internal-testing build to Production for review (submit)"
  lane :submit_production do
    options = {
      track: 'internal',
      track_promote_to: 'production',
      # 'completed' submits the production release for review / rollout; the
      # internal 'beta' upload stages it as 'draft' first (see :beta lane).
      release_status: 'completed',
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    }

    # Promote a specific build when asked (standalone submit workflow); else
    # supply promotes the latest release currently on the internal track.
    if ENV["SUBMIT_VERSION_CODE"] && !ENV["SUBMIT_VERSION_CODE"].empty?
      options[:version_code] = ENV["SUBMIT_VERSION_CODE"].to_i
    end

    upload_to_play_store(options)

    UI.success("Android build promoted to Google Play Production for review!")
  end

  desc "Deploy a new version to the Google Play (Production)"
  lane :release do
    # Build the app bundle
    build

    # Upload to Google Play Production track
    upload_to_play_store(
      track: 'production',
      aab: '../../build/app/outputs/bundle/release/app-release.aab',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'draft'
    )

    UI.success("Release uploaded to Google Play Production (as draft)!")
  end

  desc "Run tests"
  lane :test do
    sh("cd ../.. && flutter test")
    UI.success("Tests completed successfully!")
  end

  # Error handling
  error do |lane, exception|
    UI.error("Error in lane '#{lane}': #{exception}")
  end
end
