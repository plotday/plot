# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:android)

# Play Console "release name" for a track release. supply leaves this blank
# unless `version_name` is set, and on promotion it copies the source track's
# release object — name included — straight to Production. So a blank/stale name
# on the internal upload is exactly what surfaces in Production (e.g. an old
# "1.1.6" label riding on a current build). Pin it to the marketing version so
# the Play release name always tracks the app's real version.
#
# Prefer an explicit SUBMIT_APP_VERSION override (set by the standalone submit
# workflow); otherwise read the marketing half of pubspec's `version: X.Y.Z+build`
# (the release workflow stamps pubspec before building). This only labels the
# Play release — it never touches the AAB's own versionName. Returns nil on any
# problem so supply falls back to its prior behavior rather than failing.
def marketing_release_name
  override = ENV["SUBMIT_APP_VERSION"].to_s.strip
  return override unless override.empty?

  pubspec_path = File.expand_path("../../pubspec.yaml", __dir__)
  version_line = File.read(pubspec_path)[/^version:\s*(.+)$/, 1]
  version_line&.strip&.split("+")&.first
rescue StandardError => e
  UI.important("Could not derive marketing version for Play release name: #{e.message}")
  nil
end

platform :android do
  desc "Build the Android app (App Bundle)"
  lane :build do
    # Build the Flutter Android app as an App Bundle
    sh("cd ../.. && flutter build appbundle --release")

    UI.success("Android App Bundle build completed successfully!")
  end

  desc "Build APK"
  lane :build_apk do
    # Build the Flutter Android app as an APK
    sh("cd ../.. && flutter build apk --release")

    UI.success("Android APK build completed successfully!")
  end

  desc "Generate screenshots for Play Store"
  lane :screenshots do
    # Ensure the app is built
    build_apk

    # Generate screenshots using Screengrab
    screengrab(
      clear_previous_screenshots: true,
      app_apk_path: "../build/app/outputs/flutter-apk/app-release.apk"
    )

    UI.success("Screenshots generated successfully!")
  end

  desc "Upload a new beta version to the Google Play (Internal Testing)"
  lane :beta do |options|
    # Upload pre-built AAB to Google Play Internal Testing track
    # (build is done externally by Shorebird or Flutter)
    aab_path = options[:aab] || '../../build/app/outputs/bundle/release/app-release.aab'
    upload_to_play_store(
      track: 'internal',
      aab: aab_path,
      # Name the internal release after the marketing version. submit_production
      # promotes this exact release (name and all) to Production, so setting it
      # here is what keeps the Production release name from going stale.
      version_name: marketing_release_name,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'draft'
    )

    UI.success("Beta version uploaded to Google Play Internal Testing!")
  end

  desc "Upload metadata and screenshots to Google Play Console"
  lane :metadata do
    # Push the store listing (title, descriptions, feature graphic) and the
    # staged screenshots. Auth is via the Appfile's json_key_file
    # (play-deployer-service-key.json). Release notes are not managed here, so
    # skip changelogs — there is no metadata/android/en-US/changelogs dir and we
    # never want a release gated on one.
    # Honor the release workflow's update_metadata / update_screenshots flags.
    # SKIP_* default to unset => false => upload, preserving local behavior.
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: ENV["SKIP_METADATA"] == "true",
      skip_upload_images: ENV["SKIP_SCREENSHOTS"] == "true",
      skip_upload_screenshots: ENV["SKIP_SCREENSHOTS"] == "true",
      skip_upload_changelogs: true
    )

    UI.success("Metadata uploaded to Google Play Console!")
  end

  desc "Promote the internal-testing build to Production for review (submit)"
  lane :submit_production do
    options = {
      track: 'internal',
      track_promote_to: 'production',
      # 'completed' submits the production release for review / rollout; the
      # internal 'beta' upload stages it as 'draft' first (see :beta lane).
      release_status: 'completed',
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      # Release notes are not managed here and there is no
      # metadata/android/en-US/changelogs dir. Without this, supply tries to
      # upload a changelog and — on the inline release path, where
      # SUBMIT_VERSION_CODE is unset — aborts with "Cannot find changelog
      # because no version code given", so the promotion never lands. Mirrors
      # the :metadata lane.
      skip_upload_changelogs: true,
    }

    # The Production release name is NOT set here: supply's promote copies the
    # internal release object (name included) to Production, so the name comes
    # from whatever the :beta upload assigned (see marketing_release_name). A
    # version_name here would be ignored by the promote path.

    # Promote a specific build when asked (standalone submit workflow); else
    # supply promotes the latest release currently on the internal track.
    if ENV["SUBMIT_VERSION_CODE"] && !ENV["SUBMIT_VERSION_CODE"].empty?
      options[:version_code] = ENV["SUBMIT_VERSION_CODE"].to_i
    end

    upload_to_play_store(options)

    UI.success("Android build promoted to Google Play Production for review!")
  end

  desc "Deploy a new version to the Google Play (Production)"
  lane :release do
    # Build the app bundle
    build

    # Upload to Google Play Production track
    upload_to_play_store(
      track: 'production',
      aab: '../../build/app/outputs/bundle/release/app-release.aab',
      # Keep the Production release name aligned with the marketing version.
      version_name: marketing_release_name,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: 'draft'
    )

    UI.success("Release uploaded to Google Play Production (as draft)!")
  end

  desc "Run tests"
  lane :test do
    sh("cd ../.. && flutter test")
    UI.success("Tests completed successfully!")
  end

  # Error handling
  error do |lane, exception|
    UI.error("Error in lane '#{lane}': #{exception}")
  end
end
