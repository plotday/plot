# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

default_platform(:mac)

platform :mac do
  desc "Build the macOS app"
  lane :build do
    # Install CocoaPods dependencies
    cocoapods(
      clean_install: true,
      podfile: "./Podfile"
    )

    # Build the Flutter macOS app
    sh("cd ../.. && flutter build macos --release")

    UI.success("macOS build completed successfully!")
  end

  desc "Build DMG for direct distribution"
  lane :build_dmg do
    # Build the macOS app
    build

    # Note: DMG creation and signing is handled by the existing GitHub Actions workflow
    # This lane ensures the app is built and ready for DMG packaging
    # See .github/workflows/build-macos.yml for the full DMG workflow

    UI.success("macOS app built and ready for DMG packaging!")
  end

  desc "Build and archive for Mac App Store"
  lane :build_mas do
    # Install CocoaPods dependencies
    cocoapods(
      clean_install: true,
      podfile: "./Podfile"
    )

    # Build the Flutter macOS app for Mac App Store.
    # APP_STORE_BUILD compile-time flag hides upgrade / billing CTAs that are
    # disallowed under App Store guideline 3.1.1. The DMG build (lane :build)
    # omits this flag so the direct-distribution app continues to surface
    # upgrade UI.
    # Note: Requires proper provisioning profile for Mac App Store distribution
    sh("cd ../.. && flutter build macos --release --dart-define=APP_STORE_BUILD=true")

    # Create archive for Mac App Store
    gym(
      scheme: "Runner",
      workspace: "./Runner.xcworkspace",
      export_method: "app-store",
      output_directory: "../../build/macos/Build/Products/Release",
      skip_package_pkg: false,
      installer_cert_name: ENV["MAC_INSTALLER_CERT_NAME"] || "3rd Party Mac Developer Installer"
    )

    UI.success("Mac App Store build completed successfully!")
  end

  desc "Generate screenshots for Mac App Store"
  lane :screenshots do
    snapshot
    UI.success("Screenshots generated successfully!")
  end

  desc "Upload a new beta build to TestFlight (Mac)"
  lane :beta do
    # Build for Mac App Store
    build_mas

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
      platform: "osx"
    )

    UI.success("Beta build uploaded to TestFlight!")
  end

  desc "Upload metadata and screenshots to Mac App Store Connect"
  lane :metadata do
    options = {
      skip_binary_upload: true,
      # Honor the release workflow's update_metadata / update_screenshots flags.
      # SKIP_* default to unset => false => upload, preserving local behavior.
      skip_metadata: ENV["SKIP_METADATA"] == "true",
      skip_screenshots: ENV["SKIP_SCREENSHOTS"] == "true",
      # The committed store assets are the source of truth. Use deliver's sync
      # logic (checksum-diff: upload only the missing shots, delete only the
      # extras) rather than overwrite_screenshots. overwrite uploads the whole
      # set, then reads it back to verify; App Store Connect processes
      # screenshots asynchronously, so the readback fires before processing
      # finishes, reports every shot "missing on App Store Connect," and
      # blind-retries the entire set — leaving two copies of each screenshot on
      # the listing. sync_screenshots converges idempotently and is retry-safe.
      # (deliver >= 2.191; the runner ships 2.236, where it needs no env flag.)
      sync_screenshots: true,
      # We never submit for review here, so skip the metadata precheck.
      run_precheck_before_submit: false,
      force: true,
      platform: "osx",
    }

    # In CI, authenticate with the App Store Connect API key (ASC_API_* secrets
    # plus the .p8 decoded into ~/.appstoreconnect/private_keys). Locally, fall
    # back to the Appfile's apple_id session auth.
    if ENV["ASC_API_KEY_ID"] && ENV["ASC_API_ISSUER_ID"]
      options[:api_key] = app_store_connect_api_key(
        key_id: ENV["ASC_API_KEY_ID"],
        issuer_id: ENV["ASC_API_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['ASC_API_KEY_ID']}.p8")
      )
    end

    upload_to_app_store(options)

    UI.success("Metadata uploaded to Mac App Store Connect!")
  end

  desc "Deploy a new version to the Mac App Store"
  lane :release_mas do
    # Build for Mac App Store
    build_mas

    # Upload to Mac App Store
    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      platform: "osx"
    )

    UI.success("Release uploaded to Mac App Store Connect!")
  end

  desc "Submit an already-uploaded build to Mac App Store review (no binary upload)"
  lane :submit do
    options = {
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      # deliver waits for App Store Connect to finish processing the
      # altool-uploaded build automatically when submit_for_review is set
      # (BuildWatcher.wait_for_build_processing_to_be_complete), so no explicit
      # wait option is needed. The old wait_for_uploaded_build option was
      # removed from deliver and now hard-errors if passed.
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false },
      platform: "osx",
    }

    options[:build_number] = ENV["SUBMIT_BUILD_NUMBER"] if ENV["SUBMIT_BUILD_NUMBER"] && !ENV["SUBMIT_BUILD_NUMBER"].empty?
    options[:app_version] = ENV["SUBMIT_APP_VERSION"] if ENV["SUBMIT_APP_VERSION"] && !ENV["SUBMIT_APP_VERSION"].empty?

    if ENV["ASC_API_KEY_ID"] && ENV["ASC_API_ISSUER_ID"]
      options[:api_key] = app_store_connect_api_key(
        key_id: ENV["ASC_API_KEY_ID"],
        issuer_id: ENV["ASC_API_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['ASC_API_KEY_ID']}.p8")
      )
    end

    upload_to_app_store(options)

    UI.success("macOS build submitted for Mac App Store review!")
  end

  desc "Create GitHub release with DMG (integrates with existing workflow)"
  lane :release_dmg do
    UI.message("DMG releases are handled by GitHub Actions workflow")
    UI.message("See .github/workflows/build-macos.yml")
    UI.message("This lane is a placeholder for future local DMG release automation")
  end

  desc "Run tests"
  lane :test do
    sh("cd ../.. && flutter test")
    UI.success("Tests completed successfully!")
  end

  # Error handling
  error do |lane, exception|
    UI.error("Error in lane '#{lane}': #{exception}")
  end
end
