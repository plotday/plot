{
  "name": "@plotday/site",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "config": {
    "deploy_vars": "API_ROOT SUPABASE_URL SUPABASE_ANON_KEY POSTHOG_API_KEY POSTHOG_PROXY"
  },
  "scripts": {
    "env": "bash ../../scripts/gen-env development > .env",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "deploy": "bash -c 'if [[ -v DEPLOY_VARS ]]; then wrangler deploy --var $DEPLOY_VARS; else wrangler deploy --keep-vars; fi'",
    "types": "react-router typegen && tsc",
    "lint": "tsc && eslint ."
  },
  "dependencies": {
    "@mantine/core": "8.3.0",
    "@mantine/hooks": "8.3.0",
    "@react-router/node": "^7.9.2",
    "@react-router/serve": "^7.9.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.79.0",
    "@tabler/icons-react": "^3.34.1",
    "isbot": "^5.1.30",
    "posthog-js": "^1.310.1",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-router": "^7.9.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.10",
    "@react-router/dev": "^7.9.2",
    "@types/node": "^20.19.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
