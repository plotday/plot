{
  "name": "@plotday/site",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "config": {
    "deploy_vars": "API_ROOT APP_ROOT CLERK_SECRET_KEY CLERK_PUBLISHABLE_KEY POSTHOG_API_KEY POSTHOG_PROXY",
    "env_file": ".env"
  },
  "scripts": {
    "get-env": "bash ../../scripts/get-env",
    "build": "node scripts/sync-internal-docs.mjs && react-router build",
    "dev": "node scripts/sync-internal-docs.mjs && react-router dev",
    "start:local": "wrangler dev",
    "deploy": "bash -c 'if [[ -v DEPLOY_VARS ]]; then wrangler deploy --var $DEPLOY_VARS; else wrangler deploy --keep-vars; fi'",
    "types": "react-router typegen && tsc",
    "lint": "tsc && eslint ."
  },
  "dependencies": {
    "@clerk/react-router": "^3.4.2",
    "@clerk/themes": "^2.4.57",
    "@mantine/core": "8.3.11",
    "@mantine/hooks": "8.3.11",
    "@plotday/pricing": "workspace:*",
    "@react-router/node": "^7.17.0",
    "@react-router/serve": "^7.17.0",
    "@tabler/icons-react": "^3.44.0",
    "isbot": "^5.1.44",
    "marked": "^18.0.5",
    "posthog-js": "^1.396.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.17.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@react-router/dev": "^7.17.0",
    "@types/node": "^20.19.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.2",
    "vite": "8.1.3",
    "vite-tsconfig-paths": "^5.1.4",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
